+// K80 diagnostic layer only. x16-x18 are scratch in the instrumented paths;
+// preserve all incoming context, table registers, stack pointers and LR.
+.macro ZORN_SECONDARY_STAGE number
+    mrs     x16, MPIDR_EL1
+    ubfx    x16, x16, #8, #8
+    cmp     x16, #8
+    b.hs    99f
+    adrp    x17, EXT(zorn_cpu1_trace)@page
+    add     x17, x17, EXT(zorn_cpu1_trace)@pageoff
+    add     x17, x17, x16, lsl #6
+    mov     x18, #\number
+    str     x18, [x17]
+.if \number >= 7
+    dc      cvac, x17
+.endif
+    dsb     sy
+99:
+.endmacro
