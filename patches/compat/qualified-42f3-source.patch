+static void
+cs_text_fixup_init(void)
+{
+	DTEntry chosen;
+	void const *table;
+	unsigned int size;
+	if (SecureDTLookupEntry(NULL, "/chosen", &chosen) == kSuccess &&
+	    SecureDTGetProperty(chosen, "text-fixups", &table, &size) == kSuccess) {
+		const char *s = table, *end = s + size;
+		for (int i = 0; s < end && *s; i++) {
+			char entry[160];
+			size_t length = strnlen(s, (size_t)(end - s));
+			if (length < sizeof(entry) && cs_text_fixup_count < CS_TEXT_FIXUP_MAX) {
