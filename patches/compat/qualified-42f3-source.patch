+static void
+zorn_gui_sample_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	static int channel;
+	unsigned hold = 0;
+	PE_parse_boot_argn("zorn_gui_hold", &hold, sizeof(hold));
+	/* A 30-second period keeps the existing 60-sample wire bound and stays
+	 * below the independent 55-second watchdog bite. The absolute epoch
+	 * deadline in the native hold helper is never extended by this loop. */
+	unsigned period = hold > 900 && hold <= 1800 ? 30 : 15;
+	unsigned sample_limit = hold > 300 && hold <= 1800 ? (hold + period - 1) / period : 20;
+	if (period == 30) zorn_ufs_gui_hold_tick();
+	for (unsigned sample = 1; sample <= sample_limit; ++sample) {
+		(void)tsleep(&channel, PZERO, "zorngui", period * hz);
+		char text[64];
+		int n = snprintf(text, sizeof(text), "GUI SAMPLE %u/%u ", sample, sample_limit);
+		if (n > 0) zorn_ufs_user_output(0, text, (size_t)n);
+		zorn_ufs_gui_stage(sample, 1, 0);
+		if (sample == 1) zorn_gui_library_paths();
+		zorn_gui_inventory_used = 0;
+		zorn_gui_inventory_count = 0;
+		proc_iterate(PROC_ALLPROCLIST | PROC_NOWAITTRANS, zorn_gui_sample_proc, NULL,
+		    NULL, NULL);
+		zorn_ufs_gui_stage(sample, 10, 0);
+		for (size_t pos = 0; pos < zorn_gui_inventory_used; pos += 220) {
+			size_t bytes = zorn_gui_inventory_used - pos;
+			if (bytes > 220) bytes = 220;
+			char inventory[256];
+			int length = snprintf(inventory, sizeof(inventory), "PROCS total=%u offset=%lu %.*s ",
+			    zorn_gui_inventory_count, (unsigned long)pos, (int)bytes, zorn_gui_inventory + pos);
+			if (length > 0) zorn_ufs_user_output(0, inventory, (size_t)length < sizeof(inventory) ? (size_t)length : sizeof(inventory) - 1);
+		}
+		zorn_gui_data_space();
+		zorn_ufs_runtime_snapshot();
+		zorn_ufs_gui_stage(sample, 11, 0);
+		zorn_ufs_gui_hold_tick();
+	}
+	zorn_ufs_gui_stage(sample_limit, 12, 0);
+	zorn_ufs_gui_flush();
+	thread_terminate(current_thread());
+}
