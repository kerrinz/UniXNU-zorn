+	}
+	if (!zorn_gui_sample_wanted(p, NULL)) return PROC_RETURNED;
+	/* Diagnostic snapshots do not wait for an exec/exit transition. The
+	 * proc_iterate reference keeps this coallocated proc/task storage alive. */
+	if (p->p_lflag & P_LINTRANSIT) return PROC_RETURNED;
+	zorn_ufs_gui_stage(0, 2, proc_getpid(p));
+	char name[MAXCOMLEN + 1] = {0};
+	proc_name(proc_getpid(p), name, sizeof(name));
+	task_t task = proc_task(p);
