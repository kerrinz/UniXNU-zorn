+				} else {
+					printf("text-fixups[%d]: malformed, ignored\n", i);
+				}
+			} else {
+				printf("text-fixups[%d]: too long or table full, ignored\n", i);
+			}
+			s += length + 1;
+		}
+	}
+	const char *args[] = {
+		cs_text_fixup_arg0, cs_text_fixup_arg1, cs_text_fixup_arg2, cs_text_fixup_arg3,
+		cs_text_fixup_arg4, cs_text_fixup_arg5, cs_text_fixup_arg6, cs_text_fixup_arg7,
+	};
