+	__asm__ volatile(
+		"cbz x8, 1f\n"
+		"tbz x8, #63, 1f\n"
+		"ldr x0, [x8]\n"
+		"ret\n"
+		"1:\n"
+		"add x30, x30, #60\n"
+		"ret\n"
+	);
+}
