+static void
+zorn_draw_char(uintptr_t base, int row_bytes, int x, int y, int scale, const uint8_t *glyph)
+{
+	const uint32_t on = 0xFFFFFFFF;
+	const uint32_t off = 0xFF000000;
+	int row;
+	int sy;
+	int col;
+
+	/* Rows at and below 900 are outside the early framebuffer map. */
+	if (scale < 1 || x < 0 || y < 0 || x >= 1440 || y >= 900) {
+		return;
+	}
+	for (row = 0; row < 7; row++) {
+		uint8_t bits = glyph ? glyph[row] : 0;
+
+		for (sy = 0; sy < scale; sy++) {
+			int py = y + row * scale + sy;
+			int width = 6 * scale;
+			volatile uint32_t *pixel;
+			uintptr_t addr;
+
+			if (py < 0 || py >= 900) {
+				continue;
+			}
+			if (x + width > 1440) {
+				width = 1440 - x;
+			}
+			addr = base + (uintptr_t)py * (uintptr_t)row_bytes + (uintptr_t)x * 4;
+			if (addr < base || addr + (uintptr_t)width * 4 > base + 1440ull * 3200ull * 4) {
+				continue;
+			}
+			pixel = (volatile uint32_t *)addr;
+
+			for (col = 0; col < width; col++) {
+				int bit = col / scale;
+				uint32_t color = off;
+
+				if (bit < 5 && (bits & (0x10 >> bit))) {
+					color = on;
+				}
+				pixel[col] = color;
+			}
+		}
+	}
+}
+
+static void
+zorn_draw_text(uintptr_t base, int row_bytes, int *x, int y, int scale, const char *text)
+{
+	const char *cursor;
+
+	for (cursor = text; *cursor != '\0' && *x >= 0 && *x < 1440; cursor++) {
+		zorn_draw_char(base, row_bytes, *x, y, scale, zorn_glyph_for(*cursor));
+		if (*x > 1440 - 6 * scale) {
+			break;
+		}
+		*x += 6 * scale;
+	}
+}
+
+static void
+zorn_say_flush_span(uintptr_t base, int row_bytes, int y, int scale, int pixels)
+{
+	int row;
+	int byte;
+	int width;
+
+	if (pixels < 1) {
+		return;
+	}
+	width = pixels * 4;
+	if (width > row_bytes) {
+		width = row_bytes;
+	}
+	for (row = 0; row < 7 * scale; row++) {
+		uintptr_t line = base + (uintptr_t)(y + row) * (uintptr_t)row_bytes;
+
+		for (byte = 0; byte < width; byte += 64) {
+			__asm__ volatile("dc civac, %0" :: "r"(line + byte) : "memory");
+		}
+	}
+}
+
+static void
+zorn_say_flush(uintptr_t base, int row_bytes, int y, int scale)
+{
+	zorn_say_flush_span(base, row_bytes, y, scale, row_bytes / 4);
+}
