+static int
+zorn_gui_sample_proc(proc_t p, __unused void *arg)
+{
+	++zorn_gui_inventory_count;
+	if (zorn_gui_inventory_used + MAXCOMLEN + 24 < sizeof(zorn_gui_inventory)) {
+		int n = snprintf(zorn_gui_inventory + zorn_gui_inventory_used,
+		    sizeof(zorn_gui_inventory) - zorn_gui_inventory_used, "%s[%d] ", p->p_comm, proc_getpid(p));
