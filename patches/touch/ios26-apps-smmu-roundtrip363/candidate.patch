+        for (auto &page : pages_) page.reset();
+        mapping_ = {};
+        return result;
+    }
+
+public:
+    uint32_t fault() const { return __atomic_load_n(&fault_, __ATOMIC_ACQUIRE); }
+    bool retainsHardware() const { return retained_; }
+    const Smmu::Plan &plan() const { return lease_.plan(); }
+    const Dma::Mapping *mapping() const { return live_ && !fault() ? &mapping_ : nullptr; }
+
+    ArmSmmu4KStatus attachQuiesced(OSSharedPtr<IOMemoryMap> aperture, unsigned ufsBank,
+                                  void (*publish)(const void *, size_t))
+    {
+        if (retained_ || live_) return ArmSmmu4KBusy;
+        IOPhysicalLength contiguous = 0;
+        if (!aperture || !publish || aperture->getLength() != Smmu::ApertureBytes ||
+            aperture->getPhysicalSegment(0, &contiguous, kIOMemoryMapperNone) != 0x15000000 ||
+            contiguous < Smmu::ApertureBytes || !aperture->getVirtualAddress())
+            return ArmSmmu4KArgument;
+        aperture_ = aperture;
+        mmio_ = {reinterpret_cast<volatile unsigned char *>(aperture_->getVirtualAddress()), Smmu::ApertureBytes};
+        if (!bind()) return refuse(ArmSmmu4KArgument);
+        auto status = lease_.prepare(guarded_, ufsBank);
+        if (status != ArmSmmu4KSuccess) return refuse(status);
+        constexpr unsigned widths[] = {32, 36, 40, 42, 44, 48};
+        const auto code = (plan().id2 >> 4) & 15;
+        if (code >= sizeof(widths) / sizeof(widths[0])) return refuse(ArmSmmu4KUnsupported);
+        Dma::Page data{};
+        if (!allocate(0, data) || !allocate(1, tablePages_[0]) || !allocate(2, tablePages_[1]))
+            return refuse(ArmSmmu4KCapacity);
+        status = Dma::build(data, tablePages_[0], tablePages_[1], widths[code], mapping_);
+        if (status != ArmSmmu4KSuccess) return refuse(status);
+        for (const auto &page : tablePages_) publish(page.cpu, Dma::CpuPageBytes);
+        publish(data.cpu, Dma::CpuPageBytes);
+
+        intids_[0] = Smmu::GlobalFaultSpi + 32;
+        faultOffsets_[0] = 0x48;
+        for (unsigned i = 0; i < 2; ++i) {
+            const unsigned bank = plan().domains[i].bank;
+            intids_[i + 1] = Smmu::ContextFaultSpis[bank] + 32;
+            faultOffsets_[i + 1] = uint32_t(plan().contextBase + bank * Smmu::PageBytes + 0x58);
