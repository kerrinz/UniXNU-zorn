+            if ((ttbr1 >> 48) < ContextCount) asids[ttbr1 >> 48] = true;
+        } else {
+            uint32_t contextId = 0;
+            if (io.read32(io.cookie, cb + 0x34, &contextId)) return ArmSmmu4KIoError;
+            if ((contextId & 255u) < ContextCount) asids[contextId & 255u] = true;
+        }
+    }
+    unsigned selected = 0;
+    for (unsigned bank = banks; bank-- > stage2 && selected < 2;) {
+        if (occupied[bank] || asids[bank]) continue;
+        ArmSmmu4KContextImage saved{};
+        uint32_t fault = 0, actlr = 0;
+        const auto cb = plan.contextBase + bank * PageBytes;
+        if (!readImage(io, plan.contextBase, bank, saved) || io.read32(io.cookie, cb + 0x58, &fault) ||
+            io.read32(io.cookie, cb + 4, &actlr)) return ArmSmmu4KIoError;
+        if (saved.sctlr || saved.ttbr0 || saved.ttbr1 || fault || actlr) continue;
+        plan.domains[selected].bank = bank;
+        plan.domains[selected++].originalContext = saved;
+    }
+    if (selected != 2) return ArmSmmu4KCapacity;
+    out = plan;
+    return ArmSmmu4KSuccess;
+}
+
+inline bool samePlan(const Plan &a, const Plan &b)
+{
+    if (a.control != b.control || a.id0 != b.id0 || a.id1 != b.id1 ||
+        a.id2 != b.id2 || a.contextBase != b.contextBase) return false;
+    for (unsigned i = 0; i < 2; ++i) {
+        const auto &before = a.domains[i];
+        const auto &after = b.domains[i];
+        if (before.bank != after.bank || before.route.sid != after.route.sid ||
+            before.route.slot != after.route.slot || before.originalS2cr != after.originalS2cr ||
+            !sameImage(before.originalContext, after.originalContext)) return false;
+    }
+    return true;
+}
+
+inline ArmSmmu4KStatus audit(const ArmSmmu4KContextConfig &config, const ArmSmmu4KRange (&ranges)[2],
+                            ZornFt3683DmaMemory::Page page)
+{
+    using namespace ZornFt3683DmaMemory;
+    if (!valid(page) || !config.lower || !config.lower_tables ||
+        page.physical != config.lower->table_physical) return ArmSmmu4KArgument;
+    const ArmSmmu4KTableIo tableIo{&page, [](void *cookie, uint64_t pa, uint64_t *value) {
+        const auto &pool = *static_cast<const Page *>(cookie);
+        if (pa < pool.physical || (pa & 7) || pa - pool.physical > CpuPageBytes - 8) return -1;
+        *value = *reinterpret_cast<const uint64_t *>(pool.cpu + (pa - pool.physical));
+        return 0;
+    }};
+    unsigned char visited[CpuPageBytes / SmmuPageBytes]{};
+    const ArmSmmu4KAuditRegion region{ranges, 2, sizeof(visited), 4 * 512, visited, sizeof(visited)};
+    ArmSmmu4KTableAuditResult result{};
+    return ArmSmmu4KAuditTables(&tableIo, config.lower, config.lower_tables, &region,
+                                page.physical, &result);
+}
+
+enum class Phase : uint32_t { Empty, Planned, Retained, Active, Released };
+
+// One real APPs SMMU owner serializes selection, attach and detach with all
+// other config writers. Attach requires stopped masters, coherent owned RAM,
+// and live handlers for the global and two selected context fault sources.
+// The owner holds every resource on Retained, including the fault handlers.
+class Lease {
+    Plan plan_{};
+    Phase phase_ = Phase::Empty;
+    unsigned ufsBank_ = 0;
+    ArmSmmu4KConfig configs_[2]{};
+    ArmSmmu4KResult tables_[2]{};
+    ArmSmmu4KContextConfig contexts_[2]{};
+    ArmSmmu4KStreamState streams_[2]{};
+
+    bool restore(const ArmSmmu4KIo &io, const Domain &domain)
+    {
+        const auto cb = plan_.contextBase + domain.bank * PageBytes;
+        const auto &saved = domain.originalContext;
+        const auto smr = 0x800 + domain.route.slot * 4;
+        const auto s2cr = 0xc00 + domain.route.slot * 4;
+        uint32_t value = 0;
+        // FaultStreams has already blocked this SID; removing its valid SMR
+        // returns the SID to global unmatched-fault before restoring S2CR.
+        if (io.write32(io.cookie, smr, 0) || io.barrier(io.cookie) ||
+            io.read32(io.cookie, smr, &value) || value ||
+            io.write32(io.cookie, s2cr, domain.originalS2cr) || io.barrier(io.cookie) ||
+            io.read32(io.cookie, s2cr, &value) || value != domain.originalS2cr) return false;
+        if (io.write32(io.cookie, 0x1800 + domain.bank * 4, saved.cba2r) ||
+            io.write32(io.cookie, 0x1000 + domain.bank * 4, saved.cbar) ||
+            io.write32(io.cookie, cb + 0x10, saved.tcr2) ||
+            io.write32(io.cookie, cb + 0x30, saved.tcr) ||
+            io.write64(io.cookie, cb + 0x20, saved.ttbr0) ||
+            io.write64(io.cookie, cb + 0x28, saved.ttbr1) ||
+            io.write32(io.cookie, cb + 0x38, saved.mair0) ||
+            io.write32(io.cookie, cb + 0x3c, saved.mair1) || io.barrier(io.cookie)) return false;
+        ArmSmmu4KContextImage image{};
+        return readImage(io, plan_.contextBase, domain.bank, image) && sameImage(saved, image);
+    }
+
+public:
+    Lease() = default;
+    Lease(const Lease &) = delete;
+    Lease &operator=(const Lease &) = delete;
+
+    Phase phase() const { return phase_; }
+    const Plan &plan() const { return plan_; }
+
+    ArmSmmu4KStatus prepare(const ArmSmmu4KIo &io, unsigned ufsBank)
+    {
+        if (phase_ != Phase::Empty) return ArmSmmu4KBusy;
+        const auto status = select(io, ufsBank, plan_);
+        if (status != ArmSmmu4KSuccess) return status;
+        ufsBank_ = ufsBank;
+        phase_ = Phase::Planned;
+        return ArmSmmu4KSuccess;
+    }
+
+    ArmSmmu4KStatus attachQuiesced(const ArmSmmu4KIo &io, const ZornFt3683DmaMemory::Mapping &map,
+                                 const ZornFt3683DmaMemory::Page (&tablePages)[2], unsigned pollBudget)
+    {
+        if (phase_ != Phase::Planned) return ArmSmmu4KBusy;
+        if (!io.write32 || !io.write64 || !io.barrier || !pollBudget || pollBudget > 1048576 ||
+            !ZornFt3683DmaMemory::distinct(tablePages[0], tablePages[1])) return ArmSmmu4KArgument;
+        configs_[0] = map.gpi;
+        configs_[1] = map.qup;
+        tables_[0] = map.gpiTables;
+        tables_[1] = map.qupTables;
+        for (unsigned i = 0; i < 2; ++i) {
+            contexts_[i] = {&configs_[i], nullptr, &tables_[i], nullptr, plan_.id0, plan_.id2,
+                            plan_.domains[i].bank, 1, 0, 0};
+            ArmSmmu4KContextImage image{};
+            auto status = ArmSmmu4KEncodeContext(&contexts_[i], &image);
+            if (status != ArmSmmu4KSuccess) return status;
+            status = audit(contexts_[i], i ? map.qupRanges : map.gpiRanges, tablePages[i]);
+            if (status != ArmSmmu4KSuccess) return status;
+        }
+        Plan current{};
+        auto status = select(io, ufsBank_, current);
+        if (status != ArmSmmu4KSuccess) return status;
+        if (!samePlan(plan_, current)) return ArmSmmu4KStateMismatch;
+
+        phase_ = Phase::Retained;
+        for (const auto &domain : plan_.domains) {
+            const auto at = 0xc00 + domain.route.slot * 4;
+            uint32_t value = 0;
+            if (io.write32(io.cookie, at, Fault) || io.barrier(io.cookie) ||
+                io.read32(io.cookie, at, &value) || value != Fault) return ArmSmmu4KIoError;
+        }
+        for (unsigned i = 0; i < 2; ++i) {
+            const auto &domain = plan_.domains[i];
+            ArmSmmu4KStreamResult stream{};
+            status = ArmSmmu4KCheckFaultedStreams(&io, &domain.route, 1, domain.bank, &stream);
+            if (status != ArmSmmu4KSuccess) return status;
+            ArmSmmu4KProgramResult context{};
+            status = ArmSmmu4KProgramDisabledContext(&io, domain.bank, &contexts_[i], pollBudget, &context);
+            if (status != ArmSmmu4KSuccess) return status;
+            status = ArmSmmu4KAttachStreams(&io, &streams_[i], &domain.route, 1, domain.bank,
+                                           &contexts_[i], &stream);
+            if (status != ArmSmmu4KSuccess) return status;
+        }
+        phase_ = Phase::Active;
+        return ArmSmmu4KSuccess;
+    }
+
+    ArmSmmu4KStatus detachStopped(const ArmSmmu4KIo &io, unsigned pollBudget)
+    {
+        if (phase_ != Phase::Active) return ArmSmmu4KBusy;
+        if (!io.write32 || !io.write64 || !io.barrier || !pollBudget || pollBudget > 1048576)
+            return ArmSmmu4KArgument;
+        phase_ = Phase::Retained;
+        for (unsigned i = 0; i < 2; ++i) {
+            ArmSmmu4KStreamResult stream{};
+            const auto status = ArmSmmu4KObserveStreams(&io, &streams_[i], &contexts_[i], &stream);
+            if (status != ArmSmmu4KSuccess) return status;
+        }
+        for (auto &state : streams_) {
+            ArmSmmu4KStreamResult stream{};
+            const auto status = ArmSmmu4KFaultStreams(&io, &state, &stream);
+            if (status != ArmSmmu4KSuccess) return status;
+        }
+        for (unsigned i = 0; i < 2; ++i) {
+            const auto &domain = plan_.domains[i];
+            ArmSmmu4KProgramResult context{};
+            const auto status = ArmSmmu4KDisableOwnedContext(&io, domain.bank, &contexts_[i], pollBudget, &context);
+            if (status != ArmSmmu4KSuccess) return status;
+            if (!context.disabled_verified || !context.tlb_synchronized || !restore(io, domain))
+                return ArmSmmu4KStateMismatch;
+        }
+        phase_ = Phase::Released;
+        return ArmSmmu4KSuccess;
+    }
+};
+
