+        (plan.id0 & 0x48004000) != 0x48004000 || !(plan.id2 & (1u << 12)) ||
+        (plan.id1 >> 31) || plan.contextBase * 2 != ApertureBytes ||
+        !groups || banks > ContextCount || stage2 >= banks || ufsBank >= banks) return ArmSmmu4KUnsupported;
