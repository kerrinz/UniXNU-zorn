+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// Included inside ZornUfsCore26 after the checked APPs-aperture publication.
+namespace {
+ZornFt3683KernelSmmu26::Owner touchSmmuOwner363;
+}
+
+extern "C" bool zorn26_touch_apps_smmu_ready363()
+{
+    uintptr_t inherited = 0;
+    return displayAperture338.snapshot(inherited) == ZornDisplaySmmu336::Observed && inherited;
+}
+
+extern "C" void zorn26_touch_apps_smmu_roundtrip363(uint32_t (&out)[5])
+{
+    namespace Route = ZornFt3683AppsSmmu;
+    // status, attach, detach, bank pair, interrupt that latched a fault
+    out[0] = 1;
+    out[1] = out[2] = UINT32_MAX;
+    out[3] = out[4] = 0;
+    if (!preemption_enabled() || ml_at_interrupt_context() || !ml_get_interrupts_enabled()) return;
+    uintptr_t inherited = 0;
+    if (displayAperture338.snapshot(inherited) != ZornDisplaySmmu336::Observed || !inherited) return;
+    auto *const lock = gHost.lock;
+    if (!lock || !IOLockTryLock(lock)) return;
+    struct Release {
+        IOLock *lock;
+        ~Release() { IOLockUnlock(lock); }
+    } locked{lock};
+    if (!gHost.ready || gHost.poisoned || gHost.smmu != inherited || gHost.cb <= inherited) return;
+
+    // Reuse the original mapping for the UFS/display paths. The original
+    // 0xd0000 window omits the end of the advertised register aperture. The
+    // owner independently maps the complete vendor/ADT range with the same
+    // Device attributes and holds both references during configuration.
+    const auto registerRange = IODeviceMemory::withRange(0x15000000, Route::ApertureBytes);
+    auto full = registerRange ? registerRange->map(kIOMapAnywhere | kIOMapInhibitCache) : nullptr;
+    if (!full) return;
+    const uint32_t geometry = read32(inherited, 0x24);
+    const size_t cbBase = Route::PageBytes << (((geometry >> 28) & 7u) + 1);
+    const auto ufsContext = gHost.cb - inherited;
+    if (geometry >> 31 || cbBase * 2 != Route::ApertureBytes ||
+        ufsContext < cbBase || ufsContext % Route::PageBytes) return;
+    const size_t ufsBank = (ufsContext - cbBase) / Route::PageBytes;
+    if (ufsBank >= (geometry & 255u)) return;
+
+    out[1] = touchSmmuOwner363.attachQuiesced(full, unsigned(ufsBank), cacheCivac);
+    const auto &plan = touchSmmuOwner363.plan();
+    out[3] = plan.domains[0].bank | (plan.domains[1].bank << 16);
+    if (out[1] == ArmSmmu4KSuccess) out[2] = touchSmmuOwner363.detachStopped();
+    out[4] = touchSmmuOwner363.fault();
+    if (touchSmmuOwner363.retainsHardware()) {
+        out[0] = 3;
+    } else if (out[1] == ArmSmmu4KSuccess && out[2] == ArmSmmu4KSuccess) {
+        out[0] = 2;
+    }
+}
