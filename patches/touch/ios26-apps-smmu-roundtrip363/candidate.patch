+namespace ZornFt3683AppsSmmu {
+
+constexpr size_t ApertureBytes = 0x100000;
+constexpr size_t PageBytes = 0x1000;
+constexpr uint32_t Fault = 2u << 16;
+constexpr uint32_t GlobalFaultSpi = 65;
+// Context order is the OEM APPs SMMU interrupt array after its one global SPI.
+constexpr uint16_t ContextFaultSpis[] = {
+    97, 98, 99, 100, 101, 102, 103, 104, 105, 106, 107, 108, 109, 110, 111, 112,
+    113, 114, 115, 116, 117, 118, 181, 182, 183, 184, 185, 186, 187, 188, 189, 190,
+    191, 192, 315, 316, 317, 318, 319, 320, 321, 322, 323, 324, 325, 326, 327, 328,
+    329, 330, 331, 332, 333, 334, 335, 336, 337, 338, 339, 340, 341, 342, 343, 344,
+    345, 395, 396, 397, 398, 399, 400, 401, 402, 403, 404, 405, 406, 407, 408, 409,
+    418, 419, 412, 421, 706, 423, 424, 425, 689, 690, 691, 692, 693, 694, 695, 696
+};
+constexpr unsigned ContextCount = sizeof(ContextFaultSpis) / sizeof(ContextFaultSpis[0]);
+
+struct Domain {
+    ArmSmmu4KStream route;
+    unsigned bank;
+    uint32_t originalS2cr;
+    ArmSmmu4KContextImage originalContext;
+};
+
+struct Plan {
+    Domain domains[2];
+    uint32_t control, id0, id1, id2;
+    size_t contextBase;
+};
+
+inline bool readImage(const ArmSmmu4KIo &io, size_t base, unsigned bank, ArmSmmu4KContextImage &image)
+{
+    const auto cb = base + bank * PageBytes;
+    return !io.read32(io.cookie, 0x1000 + bank * 4, &image.cbar) &&
+           !io.read32(io.cookie, 0x1800 + bank * 4, &image.cba2r) &&
+           !io.read32(io.cookie, cb + 0x30, &image.tcr) &&
+           !io.read32(io.cookie, cb + 0x10, &image.tcr2) &&
+           !io.read64(io.cookie, cb + 0x20, &image.ttbr0) &&
+           !io.read64(io.cookie, cb + 0x28, &image.ttbr1) &&
+           !io.read32(io.cookie, cb + 0x38, &image.mair0) &&
+           !io.read32(io.cookie, cb + 0x3c, &image.mair1) &&
+           !io.read32(io.cookie, cb, &image.sctlr);
+}
+
+inline bool sameImage(const ArmSmmu4KContextImage &a, const ArmSmmu4KContextImage &b)
+{
+    return a.cbar == b.cbar && a.cba2r == b.cba2r && a.tcr == b.tcr && a.tcr2 == b.tcr2 &&
+           a.ttbr0 == b.ttbr0 && a.ttbr1 == b.ttbr1 && a.mair0 == b.mair0 &&
+           a.mair1 == b.mair1 && a.sctlr == b.sctlr;
+}
+
+inline ArmSmmu4KStatus select(const ArmSmmu4KIo &io, unsigned ufsBank, Plan &out)
+{
+    out = {};
+    if (io.register_bytes != ApertureBytes || !io.read32 || !io.read64) return ArmSmmu4KArgument;
+    Plan plan{};
+    uint32_t faults = 0;
+    if (io.read32(io.cookie, 0, &plan.control) || io.read32(io.cookie, 0x20, &plan.id0) ||
+        io.read32(io.cookie, 0x24, &plan.id1) || io.read32(io.cookie, 0x28, &plan.id2) ||
+        io.read32(io.cookie, 0x48, &faults)) return ArmSmmu4KIoError;
+    if (faults) return ArmSmmu4KFault;
