+    bool asids[ContextCount]{};
+    occupied[ufsBank] = true;
+    unsigned slots = 0;
+    for (unsigned i = 0; i < groups; ++i) {
+        uint32_t smr = 0, s2cr = 0;
+        if (io.read32(io.cookie, 0x800 + 4 * i, &smr) || io.read32(io.cookie, 0xc00 + 4 * i, &s2cr))
+            return ArmSmmu4KIoError;
+        if (smr & (1u << 31)) {
+            const uint32_t mask = (smr >> 16) & 0x7fffu;
+            for (const auto sid : ZornFt3683GpiRoute::StreamIds)
+                if (!((sid ^ smr) & 0xffffu & ~mask)) return ArmSmmu4KOverlap;
+            const unsigned bank = s2cr & 255u;
+            if (!(s2cr & (3u << 16)) && bank < banks) occupied[bank] = true;
+        } else if (slots < 2 && !smr && (!s2cr || s2cr == Fault)) {
+            plan.domains[slots].route = {i, uint16_t(ZornFt3683GpiRoute::StreamIds[slots])};
