+        }
+        if (fault()) return ArmSmmu4KFault;
+        status = lease_.attachQuiesced(guarded_, mapping_, tablePages_, 4096);
+        if (status != ArmSmmu4KSuccess || fault())
+            return fault() ? ArmSmmu4KFault : status;
+        live_ = true;
+        return ArmSmmu4KSuccess;
+    }
+
+    ArmSmmu4KStatus detachStopped()
+    {
+        if (!live_ || fault()) return ArmSmmu4KBusy;
+        live_ = false;
+        auto status = lease_.detachStopped(guarded_, 4096);
+        if (status != ArmSmmu4KSuccess || fault())
+            return fault() ? ArmSmmu4KFault : status;
+        for (auto intid : intids_) {
+            if (gic_v3_spi_set_enabled_checked(intid, this, false) != KERN_SUCCESS)
+                return ArmSmmu4KIoError;
+        }
+        if (fault()) return ArmSmmu4KFault;
+        for (auto intid : intids_) gic_v3_spi_detach(intid);
+        retained_ = false;
+        return refuse(ArmSmmu4KSuccess);
+    }
+};
+
+} // namespace ZornFt3683KernelSmmu26
