+// Stable lifetime, normally the kernel APPs SMMU owner. Its configuration
+// lock serializes attach and detach; interrupt state is separately atomic.
+// The actual board owner proves GPII 0/SE4 quiescent before supplying the map.
+class Owner {
+    OSSharedPtr<IOMemoryMap> aperture_;
+    OSSharedPtr<IOBufferMemoryDescriptor> pages_[3];
+    Dma::Page tablePages_[2]{};
+    Dma::Mapping mapping_{};
+    Smmu::Lease lease_;
+    ArmSmmu4KMmio mmio_{};
+    ArmSmmu4KIo raw_{};
+    ArmSmmu4KIo guarded_{};
+    uint32_t intids_[3]{};
+    uint32_t faultOffsets_[3]{};
+    uint32_t fault_ = 0;
+    bool live_ = false;
+    bool retained_ = false;
+
+    static void interrupt(void *cookie, uint32_t intid)
+    {
+        auto &owner = *static_cast<Owner *>(cookie);
+        for (unsigned i = 0; i < 3; ++i) {
+            if (owner.intids_[i] != intid) continue;
+            uint32_t value = 0;
+            const auto &io = owner.raw_;
+            const uint32_t mask = i ? 0xc00001fe : UINT32_MAX;
+            if (io.read32(io.cookie, owner.faultOffsets_[i], &value) || (value & mask)) {
+                uint32_t none = 0;
+                __atomic_compare_exchange_n(&owner.fault_, &none, i + 1, false,
+                                            __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE);
+                gic_v3_spi_set_enabled_checked(intid, &owner, false);
+            }
+            return;
+        }
+    }
+
+    bool bind()
+    {
+        if (ArmSmmu4KBindMmio(&mmio_, &raw_) != ArmSmmu4KSuccess) return false;
+        guarded_ = {this, raw_.register_bytes,
+            [](void *cookie, size_t at, uint32_t *value) {
+                const auto &owner = *static_cast<Owner *>(cookie);
+                return owner.raw_.read32(owner.raw_.cookie, at, value);
+            },
+            [](void *cookie, size_t at, uint64_t *value) {
+                const auto &owner = *static_cast<Owner *>(cookie);
+                return owner.raw_.read64(owner.raw_.cookie, at, value);
+            },
+            [](void *cookie, size_t at, uint32_t value) {
+                const auto &owner = *static_cast<Owner *>(cookie);
+                return owner.fault() ? -1 : owner.raw_.write32(owner.raw_.cookie, at, value);
+            },
+            [](void *cookie, size_t at, uint64_t value) {
+                const auto &owner = *static_cast<Owner *>(cookie);
+                return owner.fault() ? -1 : owner.raw_.write64(owner.raw_.cookie, at, value);
+            },
+            [](void *cookie) {
+                const auto &owner = *static_cast<Owner *>(cookie);
+                return owner.fault() ? -1 : owner.raw_.barrier(owner.raw_.cookie);
+            }};
+        return true;
+    }
+
+    bool allocate(unsigned index, Dma::Page &page)
+    {
+        pages_[index] = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+            IOOptionBits(kIODirectionInOut) | IOOptionBits(kIOMemoryPhysicallyContiguous) |
+            IOOptionBits(kIOMemoryMapperNone), Dma::CpuPageBytes, Dma::CpuPageBytes);
+        if (!pages_[index]) return false;
+        IOByteCount count = 0;
+        page = {static_cast<uint8_t *>(pages_[index]->getBytesNoCopy()),
+                pages_[index]->getPhysicalSegment(0, &count, kIOMemoryMapperNone)};
+        if (count < Dma::CpuPageBytes || !Dma::valid(page)) return false;
+        bzero(page.cpu, Dma::CpuPageBytes);
+        return true;
+    }
+
+    ArmSmmu4KStatus refuse(ArmSmmu4KStatus result)
+    {
