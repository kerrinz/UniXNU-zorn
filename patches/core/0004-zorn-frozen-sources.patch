+def verify_frozen_submodules(ctx, path):
+    """Use explicitly pinned local component bytes without moving any checkout."""
+    record = json.loads(path.read_text())
+    if record.get('schema_version') != 1:
+        raise Error('unsupported frozen submodule record')
+    for label, base in (('core', ctx.root), ('device', ctx.device)):
+        config = configparser.ConfigParser()
+        config.read(base / '.gitmodules')
+        selected = {config[s]['path'] for s in config.sections()}
+        expected = record.get(label, {})
+        if selected != set(expected):
+            raise Error(f'frozen {label} module set differs')
+        for relative, pin in expected.items():
+            if Path(relative).is_absolute() or '..' in Path(relative).parts:
+                raise Error('invalid frozen module path')
+            module = base / relative
+            if git(module, 'rev-parse', 'HEAD').strip() != pin['commit']:
+                raise Error(f'frozen component revision differs: {relative}')
+            for name, digest in pin['files'].items():
+                if Path(name).is_absolute() or '..' in Path(name).parts:
+                    raise Error('invalid frozen component file')
+                source = module / name
+                if not source.is_file() or hashlib.sha256(source.read_bytes()).hexdigest() != digest:
+                    raise Error(f'frozen component source differs: {relative}/{name}')
+    log(f'submodules: verified frozen revisions and source bytes from {path}; no update')
+
+
 def _clone_dir(ctx, entry, revision=None):
     # Commit-specific directories allow targets to resolve different source pins.
     revision = (revision or entry.get('commit') or entry.get('ref', '')) if ctx.schema_version == 2 else entry.get('ref', '')
