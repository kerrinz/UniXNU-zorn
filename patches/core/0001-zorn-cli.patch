+def macho_segments_and_symtab(data):
+    if data[:4] != b'\xcf\xfa\xed\xfe':
+        raise Error('prelinked kernel is not a thin Mach-O')
+    ncmds, sizeofcmds = struct.unpack_from('<II', data, 16)
+    cmd = 32
+    end = 32 + sizeofcmds
+    segments = []
+    symtab = None
+    while cmd < end:
+        cid, size = struct.unpack_from('<II', data, cmd)
+        if cid == 0x19:
+            vmaddr, vmsize, fileoff, filesize = struct.unpack_from('<QQQQ', data, cmd + 24)
+            segments.append((vmaddr, vmsize, fileoff, filesize))
+        elif cid == 0x2:
+            symtab = struct.unpack_from('<IIII', data, cmd + 8)
+        cmd += size
+    return segments, symtab
+
+
+def macho_symbol(data, name):
+    _, symtab = macho_segments_and_symtab(data)
+    if symtab is None:
+        raise Error('prelinked kernel has no symbol table')
+    symoff, nsyms, stroff, strsize = symtab
+    wanted = name.encode()
+    for index in range(nsyms):
+        n_strx, _, _, _, n_value = struct.unpack_from('<IBBHQ', data, symoff + index * 16)
+        if not n_strx or n_strx >= strsize or not n_value:
+            continue
+        end = data.find(b'\x00', stroff + n_strx, stroff + strsize)
+        if data[stroff + n_strx:end] == wanted:
+            return n_value
+    raise Error(f'{name} missing from prelinked kernel')
+
+
+def macho_va(data, file_offset):
+    segments, _ = macho_segments_and_symtab(data)
+    for vmaddr, _, fileoff, filesize in segments:
+        if fileoff <= file_offset < fileoff + filesize:
+            return vmaddr + (file_offset - fileoff)
+    raise Error(f'file offset {file_offset:#x} is not in a Mach-O segment')
+
+
+def patch_amfi_null_deref(output):
+    """D04ABBE54: AMFI loads a null field. Branch to zorn_amfi_deref instead."""
+    data = bytearray(output.read_bytes())
+    target = macho_symbol(data, '_zorn_amfi_deref')
+    pattern = bytes.fromhex('a81240f9000140f908000014')
+    sites = []
+    start = 0
+    while True:
+        at = data.find(pattern, start)
+        if at < 0:
+            break
+        sites.append(at)
+        start = at + 1
+    if len(sites) != 1:
+        raise Error(f'AMFI null-deref site matched {len(sites)} times')
+    site = sites[0] + 4
+    va = macho_va(data, site)
+    displacement = target - va
+    if displacement % 4:
+        raise Error(f'AMFI deref branch is not instruction-aligned ({displacement:#x})')
+    immediate = displacement // 4
+    if immediate < -(1 << 25) or immediate >= (1 << 25):
+        raise Error(f'AMFI deref is out of bl range ({displacement:#x})')
+    struct.pack_into('<I', data, site, 0x94000000 | (immediate & 0x03ffffff))
+    output.write_bytes(data)
+    log(f'kernel: AMFI null deref at {va:#x} -> _zorn_amfi_deref {target:#x}')
+
