+def run_board_backend(ctx, backend, stage):
+    """Run an opt-in device recipe and keep the generic package verification."""
+    if not isinstance(backend, str) or not backend:
+        raise Error('[package] release_backend must name a device script')
+    device = ctx.device.resolve()
+    entry = (device / backend).resolve()
+    if Path(backend).is_absolute() or not entry.is_relative_to(device) or not entry.is_file():
+        raise Error(f'invalid device release backend: {backend}')
+    inputs = ctx.option('release_inputs')
+    uefi = ctx.option('uefi', 'UNIXNU_UEFI')
+    if not inputs or not inputs.is_dir() or not uefi or not uefi.is_dir():
+        raise Error('the board release backend requires --release-inputs DIR and --uefi DIR')
+    run([sys.executable, '-B', str(entry), stage, '--work', str(ctx.work),
+         '--inputs', str(inputs), '--uefi', str(uefi), '--jobs', str(ctx.jobs)])
+
+
