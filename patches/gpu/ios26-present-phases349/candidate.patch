+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#pragma once
+
+#include "ZornScanoutTrace348.h"
+
+// All timestamps use mach_absolute_time. Reset only when starting a new swap,
+// so fence and issuer readiness includes sleeps across the real pending retries.
+struct ZornSwapPhases349 {
+    uint64_t queued = 0, selected = 0, paced = 0, cacheStart = 0, cacheEnd = 0;
+    bool gpu = false;
+};
+
+namespace ZornScanoutPhase349 {
+constexpr unsigned RecordWords = 4;
+constexpr unsigned Words = ZornScanoutTrace348::MaxFlips * RecordWords;
+constexpr unsigned QuantumUs = 64;
+constexpr uint32_t StatusMask = 0xf, Gpu = 1u << 4, Valid = 1u << 5, GuardShift = 6, Transferred = 1u << 15;
+
+template<class Micros>
+void pack(uint32_t *row, uint32_t swap, const ZornSwapPhases349 &phase,
+          uint64_t drawStart, uint64_t drawEnd, uint32_t status, uint32_t guard, bool transferred, Micros micros)
+{
+    row[0] = swap;
+    const uint32_t flags = (phase.gpu ? Gpu : 0) | (status & StatusMask) | ((guard & 0x1ff) << GuardShift) | (transferred ? Transferred : 0);
+    row[3] = flags << 16;
+    if (!phase.queued || phase.selected < phase.queued || phase.paced < phase.selected ||
+        phase.cacheStart < phase.paced || phase.cacheEnd < phase.cacheStart ||
+        drawStart < phase.cacheEnd || drawEnd < drawStart) return;
+    const uint64_t spans[] = {
+        phase.selected - phase.queued, phase.paced - phase.selected, phase.cacheStart - phase.paced,
+        phase.cacheEnd - phase.cacheStart, drawEnd - drawStart,
+    };
+    uint32_t duration[sizeof(spans) / sizeof(spans[0])]{};
+    for (unsigned i = 0; i < sizeof(duration) / sizeof(duration[0]); ++i) {
+        const auto value = micros(spans[i]) / QuantumUs;
+        if (value > UINT16_MAX) return;
+        duration[i] = uint32_t(value);
+    }
+    row[1] = duration[0] | (duration[1] << 16);
+    row[2] = duration[2] | (duration[3] << 16);
+    row[3] = duration[4] | ((flags | Valid) << 16);
+}
+}
