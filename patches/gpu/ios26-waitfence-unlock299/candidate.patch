+uint64_t ZornGen7HostRing26::awaitApplicationFenceIrq299(uint64_t fence,uint64_t timeoutNs)
+{
+    if(!storage_ || !normal())return timeoutNs;
+    auto &s=*storage_;
+    if(IORecursiveLockHaveLock(&s.gate) || s.issuerHeld() || s.appSerialHeld())return timeoutNs;
+    void *fenceLine=nullptr;
+    auto preflight=[&](uint32_t target)->ZornWaitPreflight299{
+        if(__atomic_load_n(&s.phase,__ATOMIC_ACQUIRE)<6 ||
+           !__atomic_load_n(&s.runtimeReady,__ATOMIC_ACQUIRE) ||
+           __atomic_load_n(&s.stopped,__ATOMIC_ACQUIRE))return ZornWaitPreflight299::Passthrough;
+        s.lockIssuer();
+        const bool valid=s.runtimeReady && bootstrapHealthy() && !s.native.poisoned() &&
+            target>0 && target<=s.native.lastSubmitted();
+        const bool done=valid && s.native.completedFence()>=target;
+        if(valid && !done){
+            uint8_t *base=static_cast<uint8_t *>(s.memory.bo(FHG_GPU_POOL_SLOT).mapping());
+            if(base)fenceLine=base+0xc8100;
+        }
+        s.unlockIssuer();
+        if(!valid)return ZornWaitPreflight299::Passthrough;
+        if(done || !fenceLine)return ZornWaitPreflight299::AlreadyComplete;
+        return ZornWaitPreflight299::WaitIrq;
+    };
+    auto readHwFence=[&]()->uint32_t{
+        __asm__ volatile("dc civac, %0\n\tdsb sy" : : "r"(fenceLine) : "memory");
+        const auto *words=static_cast<const uint32_t *>(fenceLine);
+        return __atomic_load_n(&words[1],__ATOMIC_ACQUIRE);
+    };
+    auto isStopped=[&]()->bool{
+        return __atomic_load_n(&s.stopped,__ATOMIC_ACQUIRE)!=0 || s.irq.halted() || s.gmu.halted() || s.domain.faulted();
+    };
+    auto nowNs=[]()->uint64_t{
+        uint64_t abs=0,ns=0;clock_get_uptime(&abs);absolutetime_to_nanoseconds(abs,&ns);return ns;
+    };
+    const uint32_t target32=static_cast<uint32_t>(fence);
+    auto sleepIrqNs=[&](uint64_t stepNs){
+        uint64_t deadline=0;clock_interval_to_deadline(stepNs,1,&deadline);
+        IOLockLock(s.waitGate);
+        if(!__atomic_load_n(&s.stopped,__ATOMIC_ACQUIRE) && readHwFence()<target32)
+            (void)IOLockSleepDeadline(s.waitGate,&s.irqCandidates,deadline,THREAD_UNINT);
+        IOLockUnlock(s.waitGate);
+    };
+    return zorn26_await_fence_unlocked299(fence,timeoutNs,preflight,readHwFence,isStopped,nowNs,sleepIrqNs);
+}
