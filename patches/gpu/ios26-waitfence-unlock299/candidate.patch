diff -ruN a/ZornWaitFenceScope299.h b/ZornWaitFenceScope299.h
--- a/ZornWaitFenceScope299.h	1970-01-01 08:00:00
+++ b/ZornWaitFenceScope299.h	2026-11-18 12:36:06
@@ -0,0 +1,43 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#pragma once
+#include <stdint.h>
+
+enum class ZornWaitPreflight299 : unsigned {
+    Passthrough = 0,
+    AlreadyComplete = 1,
+    WaitIrq = 2,
+};
+
+// Wait for the hardware ring fence outside per-client serial_, appSerial and
+// issuer locks so concurrent BoImport/BoMap/BoFree/GetStatus/SubmitBatch and
+// presenter lease calls proceed without blocking on GPU execution time.
+// The subsequent normal locked WaitFence call performs actual job retirement.
+template <typename PreflightFn, typename ReadHwFenceFn, typename StoppedFn,
+          typename NowNsFn, typename SleepIrqFn>
+inline uint64_t zorn26_await_fence_unlocked299(
+    uint64_t fence,
+    uint64_t timeoutNs,
+    PreflightFn &&preflight,
+    ReadHwFenceFn &&readHwFence,
+    StoppedFn &&isStopped,
+    NowNsFn &&nowNs,
+    SleepIrqFn &&sleepIrqNs)
+{
+    if (!fence || fence > 0xffffffffULL || !timeoutNs) return timeoutNs;
+    const uint32_t target = static_cast<uint32_t>(fence);
+    const ZornWaitPreflight299 state = preflight(target);
+    if (state == ZornWaitPreflight299::Passthrough) return timeoutNs;
+    if (state == ZornWaitPreflight299::AlreadyComplete) return 0;
+
+    const uint64_t start = nowNs();
+    for (;;) {
+        if (isStopped()) return timeoutNs;
+        if (readHwFence() >= target) return 0;
+        const uint64_t now = nowNs();
+        const uint64_t elapsed = now >= start ? (now - start) : timeoutNs;
+        if (elapsed >= timeoutNs) return 0;
+        const uint64_t remaining = timeoutNs - elapsed;
+        const uint64_t step = remaining < 200000ULL ? remaining : 200000ULL;
+        sleepIrqNs(step);
+    }
+}
