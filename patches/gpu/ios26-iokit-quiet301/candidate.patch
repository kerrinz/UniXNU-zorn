 // The existing retained progress owner supplies cadence metadata only.
 // Keep both-transfer diagnostic acknowledgements fast before/while a gate waits.
 #include "ZornSerialMenu297.h"
+#include "ZornIokitDaemonQuiet301.h"
+#include <libkern/c++/OSKext.h>
+static ZornIokitQuietTracker301 zornIokitQuiet301;
+static void zorn26_quiet_iokit_daemon_busy301() {
+    auto *serviceRoot = IOService::getServiceRoot();
+    if (!serviceRoot || !gIOResourceIOKitKey) return;
+    const auto snap = zornIokitQuiet301.applyOnce(
+        []() { return OSKext::iokitDaemonAvailable(); },
+        [&]() {
+            auto userRes = serviceRoot->childFromPath("IOUserResources", gIOServicePlane);
+            if (!userRes) return false;
+            auto val = userRes->copyProperty(gIOResourceIOKitKey);
+            return static_cast<bool>(val);
+        },
+        [&]() -> uint32_t { return serviceRoot->getBusyState(); },
+        [&]() { serviceRoot->adjustBusy(-1); },
+        [&]() { IOService::publishUserResource(gIOResourceIOKitKey); });
+    IOLog("K80 IOKit quiet301: applied=%u already=%u busy=%u->%u\n",
+          snap.applied, snap.alreadyPublished, snap.beforeBusy, snap.afterBusy);
+}
