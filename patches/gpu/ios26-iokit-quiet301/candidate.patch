@@ -0,0 +1,63 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#pragma once
+#include <stdint.h>
+
+// Monolithic K80 iOS 26 kernels compile with !NO_KEXTD and OSKext::iokitDaemonAvailable() == true,
+// so StartIOKitMatching() calls IOService::getServiceRoot()->adjustBusy(+1) and defers
+// IOService::publishUserResource(gIOResourceIOKitKey) until userland kernelmanagerd runs.
+// Because kernelmanagerd is omitted from the stripped LaunchDaemons set, gIOServiceRoot's busyState
+// never reaches 0, causing configd InterfaceNamer (__wait_for_IOKit_to_quiesce -> IOServiceWaitQuiet)
+// and Preferences.app (SCNetworkInterfaceCopyAllWithPreferences -> dispatch_once_wait) to block 300s.
+// Once PID 1 enters EL0 on the verified root, release that single phantom daemon busy count iff
+// OSKext::iokitDaemonAvailable() is true, IOUserResources has not already published "IOKit", and
+// gIOServiceRoot->getBusyState() > 0.
+struct ZornIokitQuietSnapshot301 {
+    uint32_t attempted = 0;
+    uint32_t applied = 0;
+    uint32_t alreadyPublished = 0;
+    uint32_t beforeBusy = 0;
+    uint32_t afterBusy = 0;
+};
+
+struct ZornIokitQuietTracker301 {
+    uint32_t state_ = 0; // 0 = idle, 1 = running, 2 = done
+    ZornIokitQuietSnapshot301 snap_{};
+
+    template <typename DaemonAvailFn, typename PublishedFn,
+              typename ReadBusyFn, typename DecBusyFn, typename PublishFn>
+    ZornIokitQuietSnapshot301 applyOnce(
+        DaemonAvailFn &&daemonAvailable,
+        PublishedFn &&isUserResourcePublished,
+        ReadBusyFn &&readRootBusy,
+        DecBusyFn &&decrementRootBusy,
+        PublishFn &&publishUserResource)
+    {
+        uint32_t expected = 0;
+        if (!__atomic_compare_exchange_n(&state_, &expected, 1u, false,
+                                         __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) {
+            while (__atomic_load_n(&state_, __ATOMIC_ACQUIRE) != 2u) {}
+            return snap_;
+        }
+        snap_.attempted = 1u;
+        const uint32_t before = readRootBusy();
+        snap_.beforeBusy = before;
+        snap_.afterBusy = before;
+        if (daemonAvailable()) {
+            if (isUserResourcePublished()) {
+                snap_.alreadyPublished = 1u;
+            } else if (before > 0) {
+                decrementRootBusy();
+                publishUserResource();
+                snap_.applied = 1u;
+                snap_.afterBusy = readRootBusy();
+            }
+        }
+        __atomic_store_n(&state_, 2u, __ATOMIC_RELEASE);
+        return snap_;
+    }
+
+    ZornIokitQuietSnapshot301 snapshot() const {
+        if (__atomic_load_n(&state_, __ATOMIC_ACQUIRE) != 2u) return {};
+        return snap_;
+    }
+};
