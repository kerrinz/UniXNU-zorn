+OwnedSupplyDisableResult NativeOwnedArcEnable::disableActual(
+    UncoupledArcCoreDisable *const *operations, size_t count)
+{
+    OwnedSupplyDisableResult out{};
+    if (!operations || count != count_ || !count ||
+        result_.assessment != OwnedSupplyEnableAssessment::ForwardReturned ||
+        !result_.source_return_available || result_.source_return || !lockActualDependencies()) return out;
+
+    // Validate the full normal-release chain before allowing a leaf change.
+    // Its locks stay held across the leaf's use-count transition and the
+    // corresponding disable of the real parent consumer, if triggered.
+    for (size_t i = 0; i < count; ++i) {
+        auto &frame = *frames_[i];
+        auto *operation = operations[i];
+        if (!operation || operation->attempted_ ||
+            !operation->sameActualBindings(frame.core.voltage_, frame.core.enable_, &frame.consumer,
+                frame.core.supplier_.arc, &frame.core.supplier_.voter, cache_, reservation_, frame.core.notifiers_) ||
+            operation->disable_.has_constraints != frame.core.disable_.has_constraints ||
+            operation->disable_.constraint_always_on != frame.core.disable_.constraint_always_on ||
+            !operation->inputs()) {
+            unlockActualDependencies();
+            return out;
+        }
+    }
+    for (size_t i = 0; i < count; ++i) {
+        auto &frame = *frames_[i];
+        out.last = operations[i]->disableActualLocked();
+        if (out.last.source_return_available) {
+            ++out.calls_returned;
+            out.source_return_available = true;
+            out.source_return = out.last.source_return;
+            break;
+        }
+        if (out.last.assessment != CoreDisableAssessment::NeedsActualSupplyDisable ||
+            !out.last.consumer_decremented || !out.last.use_count_published || frame.core.use_count_ ||
+            i + 1 == count || frame.core.supply_ != &frames_[i + 1]->core ||
+            &frame.core.supply_consumer_ != &frames_[i + 1]->consumer) break;
+        ++out.calls_returned;
+    }
+    unlockActualDependencies();
+    return out;
+}
