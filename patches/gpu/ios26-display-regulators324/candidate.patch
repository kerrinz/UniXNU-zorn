+IOReturn ZornGen7DarwinBoardOwner::setDisplayRegisterResources(bool hold)
+{
+    using namespace ZornGen7Rpmh;
+    using Phase = DisplayRegisterResources324::Phase;
+    if (!callable()) return kIOReturnNotReady;
+    auto &s = *storage_;
+    IORecursiveLockLock(s.gates.startup);
+    auto finish = [&](IOReturn result) {
+        IORecursiveLockUnlock(s.gates.startup);
+        return result;
+    };
+    auto &display = s.display_register_resources;
+    if (s.stage != Stage::CpuReady || !s.arc_startup || !s.arc_startup->result.source_forward_returned ||
+        !s.gpu_icc_inputs_ready || !s.gpu_icc_inputs || !s.owned_global_vdd_gate ||
+        !s.rsc_storage || !s.rsc_storage->forwardAllowed() || !s.rsc_cache || !s.rsc_reservation) {
+        return finish(kIOReturnNotReady);
+    }
+    if ((hold && display.phase != Phase::Idle) || (!hold && display.phase != Phase::Held)) {
+        return finish(kIOReturnNotReady);
+    }
+
+    // DISP_CC runtime resume names VDD_MM and VDD_MXA in this order.
+    // Group 3 is the registered supplied MMCX core. Group 1 is the same MX
+    // core used by the GPU and GCC. Display owns separate consumers on both.
+    if (hold) {
+        constexpr size_t groups[] = {3, 1};
+        for (const size_t group : groups) {
+            if (!s.arc_parent_devices[group] || !actualArcParentBound(group, *s.arc_parent_devices[group])) {
+                return finish(kIOReturnNotReady);
+            }
+        }
+        display.rails[0].core = s.upstream_arc_cores[0];
+        display.rails[1].core = s.owned_arc_cores[1];
+        if (!display.rails[0].core || !display.rails[1].core ||
+            !display.rails[0].core->supply_ || display.rails[1].core->supply_) return finish(kIOReturnNotReady);
+    }
+
+    display.phase = Phase::Transition;
+    auto retainFailure = [&](IOReturn result) {
+        display.phase = Phase::Retained;
+        return finish(result);
+    };
+    if (hold) {
+        for (auto &rail : display.rails) {
+            auto &core = *rail.core;
+            void *enable = allocate(sizeof(NativeOwnedArcEnable), alignof(NativeOwnedArcEnable));
+            void *raise = allocate(sizeof(NativeOwnedArcVoltage), alignof(NativeOwnedArcVoltage));
+            void *lower = allocate(sizeof(NativeOwnedArcVoltage), alignof(NativeOwnedArcVoltage));
+            if (!enable || !raise || !lower) return retainFailure(kIOReturnNoMemory);
+            rail.enable = ::new(enable) NativeOwnedArcEnable(core, rail.consumer,
+                *s.rsc_cache, *s.rsc_reservation, s.gates.startup);
+            rail.raise = ::new(raise) NativeOwnedArcVoltage(*rail.enable, *s.rsc_cache, *s.rsc_reservation);
+            rail.lower = ::new(lower) NativeOwnedArcVoltage(*rail.enable, *s.rsc_cache, *s.rsc_reservation);
+            for (auto *node = &core; node; node = node->supply_) {
+                if (rail.disableCount == 2) return retainFailure(kIOReturnNotReady);
+                auto *consumer = node == &core ? &rail.consumer : &core.supply_consumer_;
+                void *memory = allocate(sizeof(UncoupledArcCoreDisable), alignof(UncoupledArcCoreDisable));
+                if (!memory) return retainFailure(kIOReturnNoMemory);
+                rail.disable[rail.disableCount++] = ::new(memory) UncoupledArcCoreDisable(
+                    node->voltage_, node->enable_, node->disable_, consumer, node->supplier_.arc,
+                    &node->supplier_.voter, *s.rsc_cache, *s.rsc_reservation, node->notifiers_);
+            }
+            IOLockLock(core.dependent_);
+            if (core.exclusive_ || core.open_count_ == UINT32_MAX) {
+                IOLockUnlock(core.dependent_);
+                return retainFailure(kIOReturnNotReady);
+            }
+            rail.consumer.next = core.consumers_;
+            core.consumers_ = &rail.consumer;
+            ++core.open_count_;
+            IOLockUnlock(core.dependent_);
+            if (!rail.enable->prepareActualHeldStartup()) return retainFailure(kIOReturnNotReady);
+        }
+    } else {
+        // The display caller must retire its register accesses before this
+        // entry. It releases the SDE bus vote before the DISP_CC rail votes.
+        const auto raw = s.gpu_icc_inputs->setDisplayRegisterBandwidth(0);
+        if (raw != kIOReturnSuccess) return retainFailure(raw);
+    }
+
+    IORecursiveLockUnlock(s.gates.startup);
+    IOLockLock(s.owned_global_vdd_gate);
+    bool returned = true;
+    for (auto &rail : display.rails) {
+        if (!s.rsc_storage->forwardAllowed()) { returned = false; break; }
+        // qcom_cc_runtime_resume votes level 1 (MIN_SVS = 48). The existing
+        // native regulator applies the real constraints and ARC selector.
+        // Normal unvote sets level 0 before the matching disable.
+        auto voltage = (hold ? rail.raise : rail.lower)->setActualRange(hold ? 48 : 0, INT32_MAX);
+        if (!voltage.source_return_available || voltage.source_return || !s.rsc_storage->forwardAllowed()) {
+            returned = false;
+            break;
+        }
+        if (hold) {
+            const auto result = rail.enable->enableActual();
+            returned = result.source_return_available && !result.source_return;
+        } else {
+            const auto result = rail.enable->disableActual(rail.disable, rail.disableCount);
+            returned = result.source_return_available && !result.source_return && result.last.consumer_decremented;
+        }
+        if (!returned) break;
+    }
+    IOLockUnlock(s.owned_global_vdd_gate);
+    IORecursiveLockLock(s.gates.startup);
+    if (!returned || !s.rsc_storage->forwardAllowed()) return retainFailure(kIOReturnNotReady);
+
+    if (hold) {
+        // This is the independent SDE register path's first nonzero vector
+        // (14,000 kB/s). DISP_CC itself has no interconnect edge in zorn FDT.
+        const auto raw = s.gpu_icc_inputs->setDisplayRegisterBandwidth(14000);
+        if (raw != kIOReturnSuccess) return retainFailure(raw);
+        display.phase = Phase::Held;
+    } else {
+        for (auto &rail : display.rails) {
+            auto &core = *rail.core;
+            IOLockLock(core.dependent_);
+            auto **slot = &core.consumers_;
+            while (*slot && *slot != &rail.consumer) slot = &(*slot)->next;
+            if (!*slot || rail.consumer.enable_count || !core.open_count_) {
+                IOLockUnlock(core.dependent_);
+                return retainFailure(kIOReturnNotReady);
+            }
+            *slot = rail.consumer.next;
+            rail.consumer.next = nullptr;
+            --core.open_count_;
+            IOLockUnlock(core.dependent_);
+        }
+        // The membership is retired. The board still owns these one-shot
+        // request frames until their asynchronous transports permit disposal.
+        display.phase = Phase::Released;
+    }
+    return finish(kIOReturnSuccess);
+}
