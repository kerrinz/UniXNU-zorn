diff -ruN a/ZornNominalOpp305.h b/ZornNominalOpp305.h
--- a/ZornNominalOpp305.h	1970-01-01 08:00:00
+++ b/ZornNominalOpp305.h	2026-11-18 14:18:30
@@ -0,0 +1,20 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#pragma once
+#include <stdint.h>
+
+// Exact K80 (zorn / SM8650 / Adreno 750v2) stock_0_power_3[6] & stock_0_ddr[5]
+// nominal operating point from ZornGen791StockVoteData.inc (qcom,gpu-pwrlevels-3):
+//   row 6: gpu_freq_hz = 578,000,000 (0x22739480), voltage = 0x80 (NOM), bus_freq = 5
+//   stock_0_ddr[5] = 8,171,875 kbps (0x7cb163), stock_0_ddr[9] = 16,500,000 kbps (0xfbc520)
+// Replaces the 231 MHz MIN_SVS idle boot floor (row 11 / bus 1) so 25-pass
+// Liquid Glass desktop compositing runs at K80's stock nominal corner.
+namespace ZornNominalOpp305 {
+constexpr uint32_t kActiveRows = 12u;
+constexpr uint32_t kSelectedRow = 6u;
+constexpr uint32_t kPerfIndex = kActiveRows - kSelectedRow; // 6u
+constexpr uint32_t kGpuFreqHz = 578000000u;
+constexpr uint32_t kVoltageCornerNom = 0x80u;
+constexpr uint32_t kBusLevel = 5u;
+constexpr uint32_t kDdrKbps = 8171875u;
+constexpr uint32_t kMaxDdrKbps = 16500000u;
+}
