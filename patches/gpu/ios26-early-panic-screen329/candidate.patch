+// The panic formatter already owns the first message. Use its published
+// bytes and the existing console mapping. Do not enter IOKit, locks or storage.
+void zorn26_early_panic_screen329(void);
+void zorn26_early_panic_screen329(void)
+{
+    if (__atomic_load_n(&panicReason236.state, __ATOMIC_ACQUIRE) != 2 || !panicReason236.bytes) return;
+    Hjt26Surface surface;
+    uintptr_t base = (uintptr_t)vinfo.v_baseaddr;
+    size_t capacity = (size_t)vinfo.v_rowbytes * vinfo.v_height;
+    if ((base >> 48) != 0xffff || !hjt26_surface(&surface, base, vinfo.v_width,
+        vinfo.v_height, vinfo.v_rowbytes, vinfo.v_depth, capacity) ||
+        surface.width < 960 || surface.height < 1200) return;
+
+    const unsigned scale = 6;
+    const unsigned glyph_width = 8 * scale, glyph_height = 16 * scale;
+    const unsigned columns = (surface.width - 32) / glyph_width;
+    const unsigned rows = 8, x_start = (surface.width - columns * glyph_width) / 2;
+    const unsigned y_start = surface.height / 3;
+    if (y_start + rows * glyph_height > surface.height) return;
+    rsc_stage_rect(&surface, x_start, y_start, columns * glyph_width, rows * glyph_height, 0xff000000u);
+    unsigned row = 0, column = 0;
+    for (unsigned i = 0; i < panicReason236.bytes && i < 224 && row < rows; ++i) {
+        unsigned char ch = (unsigned char)panicReason236.text[i];
+        if (ch == '\r') continue;
+        if (ch == '\n') { ++row; column = 0; continue; }
+        if (column == columns) { ++row; column = 0; }
+        if (row == rows) break;
+        if (ch < 32 || ch > 126) ch = '?';
+        const unsigned x = x_start + column * glyph_width, y = y_start + row * glyph_height;
+        for (unsigned r = 0; r < 16; ++r) {
+            const unsigned bits = iso_font[(unsigned)ch * 16 + r];
+            for (unsigned c = 0; c < 8; ++c)
+                if (bits & (1u << c))
+                    rsc_stage_rect(&surface, x+c*scale, y+r*scale, scale, scale, 0xffeeeeeeu);
+        }
+        ++column;
+    }
+    __asm__ volatile("dsb sy" ::: "memory");
+}
