+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#pragma once
+
+#include "ZornScanoutHandoff345.h"
+
+namespace ZornScanoutFlipOwnership348 {
+
+// Owned by the display writer lock. Neither slot may be repurposed without
+// proving the scanout has stopped reading it. The monotonically increasing
+// publication sequence is independent of the compositor's wrapping swap ID.
+class Ownership {
+public:
+    struct Frame {
+        uint64_t sequence = 0;
+        uint32_t swap = 0;
+        uint32_t from = 0, to = 0;
+        uint64_t queued = 0, ready = 0, programmed = 0, completed = 0;
+    };
+
+    uint32_t writableAddress() const
+    {
+        if (uncertain_ || pending_.sequence) return 0;
+        return active_ == ZORN_SCANOUT_FRONT ? ZORN_SCANOUT_BACK : ZORN_SCANOUT_FRONT;
+    }
+
+    bool stage(uint64_t sequence, uint32_t swap, uint32_t target,
+               uint64_t queued, uint64_t ready)
+    {
+        if (!target || target != writableAddress() || !queued || ready < queued ||
+            sequence <= lastSequence_) return false;
+        pending_ = {sequence, swap, active_, target, queued, ready, 0, 0};
+        lastSequence_ = sequence;
+        return true;
+    }
+
+    bool program(uint64_t sequence, uint64_t started)
+    {
+        if (uncertain_ || !pending_.sequence || sequence != pending_.sequence ||
+            pending_.programmed || started < pending_.ready) return false;
+        pending_.programmed = started;
+        return true;
+    }
+
+    // A pre-programming qualification failure is distinguishable from a
+    // failed observation after a store. Only the former permits reuse.
+    void rejectBeforeProgram(uint64_t sequence)
+    {
+        if (!uncertain_ && sequence == pending_.sequence && !pending_.programmed)
+            pending_ = {};
+    }
+
+    bool complete(uint64_t sequence, uint32_t pipe0, uint32_t pipe1,
+                  uint32_t frameDelta, bool freshDsi, uint64_t observed)
+    {
+        if (uncertain_ || !pending_.programmed) return false;
+        if (sequence != pending_.sequence || pipe0 != pending_.to || pipe1 != pending_.to ||
+            frameDelta != 1 || !freshDsi || observed <= pending_.programmed ||
+            observed <= shown_.completed) {
+            markUncertain();
+            return false;
+        }
+        pending_.completed = observed;
+        active_ = pending_.to;
+        shown_ = pending_;
+        pending_ = {};
+        return true;
+    }
+
+    // Call immediately on any failure that might follow a source store.
+    void markUncertain() { uncertain_ = true; }
+    bool uncertain() const { return uncertain_; }
+    bool originalRestored() const
+    {
+        return !uncertain_ && !pending_.sequence && active_ == ZORN_SCANOUT_FRONT;
+    }
+    const Frame &shown() const { return shown_; }
+
+private:
+    uint32_t active_ = ZORN_SCANOUT_FRONT;
+    uint64_t lastSequence_ = 0;
+    bool uncertain_ = false;
+    Frame pending_{}, shown_{};
+};
+
+} // namespace ZornScanoutFlipOwnership348
