+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#pragma once
+
+#include "ZornScanoutFlipOwnership348.h"
+#include "ZornScanoutTrace348.h"
+
+namespace ZornGopLiveSession348 {
+namespace T = ZornScanoutTrace348;
+
+struct Session {
+    uint32_t (&out)[T::Words];
+    void *context;
+    bool (*enter)(Session &);
+    bool (*transfer)(Session &, uint32_t swap, uint32_t target, uint64_t queued, uint64_t ready);
+    void (*restore)(Session &, uint8_t *original);
+    uint8_t *back = nullptr;
+    uint64_t deadline = 0, deadlineUs = 0;
+    ZornScanoutFlipOwnership348::Ownership buffers{};
+
+    uint8_t *visible(uint8_t *original) const
+    {
+        return buffers.shown().to == ZORN_SCANOUT_BACK ? back : original;
+    }
+
+    uint8_t *writable(uint8_t *original, uint32_t address) const
+    {
+        return address == ZORN_SCANOUT_BACK ? back : original;
+    }
+};
+
+// Caller owns the GOP writer lock. The two exact K80 aliases are distinct
+// and source remains read-only. Both are uncached; use naturally aligned
+// accesses to avoid the implicit zero/unaligned operations of bulk memcpy.
+inline void seed(uint8_t *target, const uint8_t *visible)
+{
+    auto *out = reinterpret_cast<volatile uint64_t *>(target);
+    auto *in = reinterpret_cast<const volatile uint64_t *>(visible);
+    for (unsigned i = 0; i < ZORN_SCANOUT_BYTES / sizeof(uint64_t); ++i) out[i] = in[i];
+}
+
+inline void record(uint32_t (&out)[T::Words], const ZornScanoutFlipOwnership348::Ownership::Frame &frame)
+{
+    const unsigned index = out[T::Completed]++;
+    auto *row = out + T::Frames + index * T::FrameWords;
+    // All observation times are within the independent 300-second boot
+    // watchdog. The two internal stages use four-microsecond units.
+    row[0] = frame.swap;
+    row[1] = uint32_t(frame.queued);
+    row[2] = uint32_t(frame.completed);
+    const auto copyToProgram = (frame.programmed - frame.ready) / 4;
+    const auto programToDone = (frame.completed - frame.programmed) / 4;
+    if (copyToProgram >= 0xffff || programToDone >= 0xffff) {
+        ++out[T::TimingLost];
+        row[3] = UINT32_MAX;
+    } else {
+        row[3] = uint32_t(copyToProgram) | (uint32_t(programToDone) << 16);
+    }
+}
+
