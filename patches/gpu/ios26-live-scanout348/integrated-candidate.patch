+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#pragma once
+
+#include "ZornDpuAutoRefreshTransfer340.h"
+#include "ZornScanoutFlipOwnership348.h"
+
+namespace ZornScanoutLive348 {
+namespace Dpu = ZornDpuAutoRefreshTransfer340;
+using ZornScanoutFlipOwnership348::Ownership;
+
+// The caller holds the GOP writer lock and has finished all stores to the
+// invisible target. The existing K80 transfer verifies both controller source
+// registers, full-frame advance, a fresh DSI completion and its acknowledgement.
+template<class Port>
+bool present(Port &port, Ownership &buffers, uint64_t seq, uint32_t swap,
+             uint32_t target, uint64_t queued, uint64_t ready, uint32_t (&report)[Dpu::Words], uint64_t deadline = 0)
+{
+    for (auto &word : report) word = 0;
+    if (!buffers.stage(seq, swap, target, queued, ready)) return false;
+    const uint32_t current = target == ZORN_SCANOUT_BACK ? ZORN_SCANOUT_FRONT : ZORN_SCANOUT_BACK;
+    Dpu::Timing times{};
+    Dpu::run(port, current, ZORN_SCANOUT_STRIDE, report, target, Dpu::Mode::FourTe, &times, deadline);
+    if (!report[Dpu::Sequence]) {
+        buffers.rejectBeforeProgram(seq);
+        return false;
+    }
+    if (!buffers.program(seq, times.programmed) || report[Dpu::Status] != Dpu::TransferObserved ||
+        report[Dpu::Retain]) {
+        buffers.markUncertain();
+        return false;
+    }
+    return buffers.complete(seq, times.source0, times.source1, report[Dpu::FrameDelta],
+                            report[Dpu::DsiUs] != 0, times.completed);
+}
