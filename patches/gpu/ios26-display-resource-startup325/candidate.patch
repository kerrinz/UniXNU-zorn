+IOReturn ZornGen7DarwinBoardOwner::probeDisplayRegisterResources325()
+{
+    if (!callable()) return kIOReturnNotReady;
+    uint32_t idle = 0;
+    if (!__atomic_compare_exchange_n(&displayLeasePhase325, &idle, 1u, false,
+            __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) return kIOReturnExclusiveAccess;
+    uint64_t now = 0, ns = 0;
+    clock_get_uptime(&now);
+    absolutetime_to_nanoseconds(now, &ns);
+    auto &state = *storage_;
+    auto readClock = [&](uint32_t &value) { return zorn26_read_display_gcc325(state.platform, value); };
+    auto setLease = [&](bool hold) { return uint32_t(setDisplayRegisterResources(hold)); };
+    auto getSteps = [&](bool hold) {
+        const auto &probe = state.display_register_resources;
+        return hold ? probe.acquireSteps : probe.releaseSteps;
+    };
+    const auto raw = ZornDisplayLeaseProbe325::run(readClock, setLease, getSteps,
+        uint32_t(ns / 1000000), uint32_t(kIOReturnIOError), displayLeaseWords325);
+    __atomic_store_n(&displayLeasePhase325, 2u, __ATOMIC_RELEASE);
+    return IOReturn(raw);
+}
