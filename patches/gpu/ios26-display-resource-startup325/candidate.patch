+namespace ZornDisplayLeaseProbe325 {
+
+enum Field : unsigned {
+    Status, UptimeMs, AcquireRaw, ReleaseRaw, GccBefore, GccHeld, GccAfter,
+    AcquireSteps, ReleaseSteps, Words
+};
+enum State : uint32_t {
+    NotRun, ClockUnavailable, AcquireFailed, HeldClockUnavailable,
+    ReleaseFailed, AfterClockUnavailable, Returned
+};
+enum Step : uint32_t {
+    CheckedExistingProxies = 1u << 0,
+    PreparedConsumers = 1u << 1,
+    MmcxVoltageReturned = 1u << 2,
+    MmcxReferenceReturned = 1u << 3,
+    MxVoltageReturned = 1u << 4,
+    MxReferenceReturned = 1u << 5,
+    BandwidthReturned = 1u << 6,
+    RemovedConsumers = 1u << 7
+};
+
+// A returned lease means the native operations returned successfully. Only
+// the always-on GCC word was sampled; this cannot authorize a DPU or DSI read.
+// The writer owns all calls and publishes a single immutable result.
+template <typename ReadClock, typename SetLease, typename GetSteps>
+uint32_t run(ReadClock readClock, SetLease setLease, GetSteps getSteps, uint32_t stamp,
+             uint32_t clockUnavailable, uint32_t (&out)[Words])
+{
+    out[UptimeMs] = stamp;
+    if (!readClock(out[GccBefore])) {
+        out[Status] = ClockUnavailable;
+        return clockUnavailable;
+    }
+    out[AcquireRaw] = setLease(true);
+    out[AcquireSteps] = getSteps(true);
+    if (out[AcquireRaw]) {
+        out[Status] = AcquireFailed;
+        return out[AcquireRaw];
+    }
+    if (!readClock(out[GccHeld])) {
+        out[Status] = HeldClockUnavailable;
+        return clockUnavailable;
+    }
+    out[ReleaseRaw] = setLease(false);
+    out[ReleaseSteps] = getSteps(false);
+    if (out[ReleaseRaw]) {
+        out[Status] = ReleaseFailed;
+        return out[ReleaseRaw];
+    }
+    if (!readClock(out[GccAfter])) {
+        out[Status] = AfterClockUnavailable;
+        return clockUnavailable;
+    }
+    out[Status] = Returned;
+    return 0;
+}
+
