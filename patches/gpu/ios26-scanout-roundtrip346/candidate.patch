+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#pragma once
+
+#include "ZornDpuAutoRefreshTransfer340.h"
+
+namespace ZornScanoutRoundTrip346 {
+namespace Dpu = ZornDpuAutoRefreshTransfer340;
+struct Report {
+    uint32_t forward[Dpu::Words]{};
+    uint32_t restore[Dpu::Words]{};
+
+    bool restored() const { return restore[Dpu::Status] == Dpu::TransferObserved; }
+
+    // After a successful forward flip the back buffer remains the active
+    // scanout until the original address retires an independently proven frame.
+    bool mustRetain() const
+    {
+        return forward[Dpu::Retain] || restore[Dpu::Retain] ||
+            (forward[Dpu::Status] == Dpu::TransferObserved && !restored());
+    }
+};
+
+// Both allocations and the MMIO lease must already be held. The caller
+// keeps both frame buffers immutable through the round trip. holdBack()
+// may observe the still frame while the hardware uses it.
+template<class Port, class HoldBack>
+Report flipAndRestore(Port &port, HoldBack holdBack)
+{
+    Report report;
+    Dpu::run(port, ZORN_SCANOUT_FRONT, ZORN_SCANOUT_STRIDE, report.forward, ZORN_SCANOUT_BACK);
+    if (report.forward[Dpu::Status] == Dpu::TransferObserved && holdBack()) {
+        Dpu::run(port, ZORN_SCANOUT_BACK, ZORN_SCANOUT_STRIDE, report.restore, ZORN_SCANOUT_FRONT);
+    }
+    return report;
+}
+}
