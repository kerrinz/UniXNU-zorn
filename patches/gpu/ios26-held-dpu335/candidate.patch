+{
+    using namespace ZornDisplayClockRead334;
+    result = {};
+    uint32_t state[ZornDisplayClockRead334::Words]{};
+    const auto readiness = checkedClock(clock, state);
+    if (readiness != Result::Observed) return readiness;
