+IOReturn ZornGen7DirectSubmit26::cancelUnpublishedIbHolds(Job &job, const uint64_t *handles,
+    size_t count, uint32_t queue)
+{
+    job={};
+    IOReturn failed=kIOReturnSuccess;
+    while(count) {
+        const auto handle=handles[--count];
+        const auto status=vm_->retireJobAfterCompletion(handle);
+        if(status) {
+            if(!failed)failed=status;
+            job.handles[job.count++]=handle;
+        } else {
+            ++stats_.references_retired;
+        }
+    }
+    if(!failed)return kIOReturnSuccess;
+    // The attempted IBs never reached the ring. Preserve just their failed
+    // reference returns and prevent this submit owner from admitting work.
+    job.queue=queue;
+    job.active=true;
+    ++stats_.poisoned_jobs;
+    (void)poison();
+    return failed;
 }
