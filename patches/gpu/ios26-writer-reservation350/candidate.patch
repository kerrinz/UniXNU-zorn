+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#pragma once
+
+#include <stdint.h>
+
+namespace ZornGopWriterReservation350 {
+
+// Carries only an uptime deadline, never a borrowed board-worker pointer.
+// The presenter yields at the next frame boundary while a live request is
+// pending. A delayed owner cannot strand the writer after the deadline.
+class Reservation {
+public:
+    bool begin(uint64_t deadline, uint64_t now)
+    {
+        uint64_t expected = 0;
+        return deadline > now && __atomic_compare_exchange_n(&deadline_, &expected, deadline,
+            false, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE);
+    }
+
+    bool writerShouldYield(uint64_t now) const
+    {
+        return now < __atomic_load_n(&deadline_, __ATOMIC_ACQUIRE);
+    }
+
+    bool finish(uint64_t deadline)
+    {
+        if (!deadline) return false;
+        return __atomic_compare_exchange_n(&deadline_, &deadline, uint64_t(0),
+            false, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE);
+    }
+
+private:
+    uint64_t deadline_ = 0;
+};
+
+} // namespace ZornGopWriterReservation350
