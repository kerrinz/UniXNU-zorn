+// Access only the fixed K80 read-only windows, on the existing bounded observer thread.
+class DisplayRead318 {
+    IOMemoryMap *maps[3]{};
+
+public:
+    ~DisplayRead318()
+    {
+        for (auto *mapping : maps) {
+            if (mapping) mapping->release();
+        }
+    }
+
+    bool operator()(ZornDisplayTiming318::Window window, uint32_t offset, uint32_t &value)
+    {
+        const unsigned index = unsigned(window);
+        if (index >= sizeof(maps) / sizeof(maps[0])) return false;
+        const auto &range = ZornDisplayTiming318::Windows[index];
+        if ((offset & 3) || offset > range.bytes - sizeof(uint32_t)) return false;
+        if (!maps[index]) {
+            IODeviceMemory *memory = IODeviceMemory::withRange(range.address, range.bytes);
+            if (!memory) return false;
+            auto *map = memory->map(kIOMapAnywhere | kIOMapInhibitCache | kIOMapReadOnly);
+            memory->release();
+            if (!map) return false;
+            if (!map->getVirtualAddress() || (map->getVirtualAddress() & 3) ||
+                map->getLength() < range.bytes || map->getPhysicalAddress() != range.address) {
+                map->release();
+                return false;
+            }
+            maps[index] = map;
+        }
+        const auto *regs = reinterpret_cast<const volatile uint32_t *>(maps[index]->getVirtualAddress());
+        value = regs[offset / sizeof(uint32_t)];
+        __asm__ volatile("dmb oshld" ::: "memory");
+        return true;
+    }
+};
+
+bool inheritedGop318()
+{
+    PE_Video boot{};
+    constexpr uint64_t first = 0xfc400000;
+    constexpr uint64_t end = first + 0x02b00000;
+    if (PE_current_console(&boot) || boot.v_width != 1440 || boot.v_height != 3200 ||
+        boot.v_depth != 32 || boot.v_offset || boot.v_rotate || boot.v_rowBytes < 1440 * 4 ||
+        (boot.v_rowBytes & 3) || boot.v_baseAddr < first || boot.v_baseAddr >= end) {
+        return false;
+    }
+    const uint64_t bytes = end - boot.v_baseAddr;
+    return boot.v_rowBytes <= bytes / boot.v_height;
+}
