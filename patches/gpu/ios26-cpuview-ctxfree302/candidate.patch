diff -ruN a/ZornCpuViewContextFree302.h b/ZornCpuViewContextFree302.h
--- a/ZornCpuViewContextFree302.h	1970-01-01 08:00:00
+++ b/ZornCpuViewContextFree302.h	2026-11-18 13:24:36
@@ -0,0 +1,27 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#pragma once
+#include <stdint.h>
+#include "NativeAdrenoABI.h"
+
+// All 12 NativeAdrenoABI methods that operate purely on CPU-side BO descriptors,
+// physical/IOSurface memory pinning, per-BO metadata, logical queue slots, or
+// the global CP timer — without reading/writing SMMU page tables or GPU VA.
+// Keeping BoImport, BoAlloc, SetMetadata, GetMetadata, CreateQueue and CloseQueue
+// context-free prevents leaveApplicationContext() from executing a synchronous
+// RestoreKernel -> quiesceKernelIo() GPU drain + CP context reset while earlier
+// SubmitBatch work is actively rendering on the GPU.
+constexpr inline bool zorn26_native_context_free_method302(uint32_t method)
+{
+    return method == NativeAdrenoMethodQuery ||
+           method == NativeAdrenoMethodBoAlloc ||
+           method == NativeAdrenoMethodBoImport ||
+           method == NativeAdrenoMethodGetDeviceInfo ||
+           method == NativeAdrenoMethodGetTimestamp ||
+           method == NativeAdrenoMethodBoCpuMap ||
+           method == NativeAdrenoMethodBoCpuUnmap ||
+           method == NativeAdrenoMethodCreateQueue ||
+           method == NativeAdrenoMethodCloseQueue ||
+           method == NativeAdrenoMethodSetMetadata ||
+           method == NativeAdrenoMethodGetMetadata ||
+           method == NativeAdrenoMethodGetStatus;
+}
