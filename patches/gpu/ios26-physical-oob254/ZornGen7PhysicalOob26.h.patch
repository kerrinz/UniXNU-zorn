--- /dev/null
+++ b/ZornGen7PhysicalOob26.h
@@ -0,0 +1,94 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Direct OOB request/clear sequence retained from ZornGen7DirectHfi26.cpp.
+// Physical lease ownership and integration added for the K80 iOS26 backend.
+#pragma once
+#include <IOKit/IOLib.h>
+#include <libkern/c++/OSObject.h>
+class ZornGen7AppExecution26;
+class ZornGen7HostRing26;
+class ZornGen7DirectHfi26;
+class ZornGen7HwschedHfi26;
+// The real Ring owns this physical transaction storage for its lifetime.
+// A lease owns its exact transport/register-map references independently of
+// client metadata. It grants no Board,task,MMIO,VM or DMA permission.
+// Caller serialization is the Ring's actual issuer/transition gate;protocol
+// mutations additionally hold the actual transport's command gate.
+class ZornGen7PhysicalOob26 final {
+    friend class ZornGen7HostRing26;
+    friend class ZornGen7AppExecution26;
+    friend class ZornGen7DirectHfi26;
+    friend class ZornGen7HwschedHfi26;
+    struct Lease {
+        ZornGen7PhysicalOob26 *physical=nullptr;
+        ZornGen7AppExecution26 *member=nullptr;
+        OSObject *transport=nullptr,*registerMaps=nullptr;
+        uint64_t generation=0;
+        bool retired=false;
+        // Fresh actual OOB observations. No kernel-result copy or reset.
+        OSObject *owner=nullptr;
+        bool attempted=false,requestReturned=false,ackObserved=false,ackCleared=false,gxOn=false;
+        bool releaseAttempted=false,releaseWriteReturned=false;
+        uint32_t ack=0,host=0,gx=0;int raw=0;
+    };
+    Lease *active_=nullptr;
+    uint64_t generation_=0;
+    ZornGen7PhysicalOob26(const ZornGen7PhysicalOob26 &)=delete;
+    ZornGen7PhysicalOob26 &operator=(const ZornGen7PhysicalOob26 &)=delete;
+    IOReturn reserve(ZornGen7AppExecution26 &member,OSObject &transport,
+        OSObject &registerMaps,Lease *&out)
+    {
+        if(out)return kIOReturnBadArgument;
+        if(active_ || generation_==UINT64_MAX)return kIOReturnExclusiveAccess;
+        auto *p=IONewZero(Lease,1);if(!p)return kIOReturnNoMemory;
+        transport.retain();registerMaps.retain();
+        p->physical=this;p->member=&member;p->transport=&transport;p->registerMaps=&registerMaps;
+        p->generation=++generation_;active_=p;out=p;return kIOReturnSuccess;
+    }
+    bool owns(const ZornGen7AppExecution26 &member,const Lease *p) const
+    {
+        return p && active_==p && p->physical==this && p->member==&member &&
+            !p->retired && p->generation && p->generation==generation_ &&
+            p->transport && p->registerMaps;
+    }
+    static bool releaseReturned(const Lease &p)
+    {
+        return p.owner==p.transport && p.attempted && p.requestReturned &&
+            p.ackObserved && p.ackCleared && p.gxOn && p.releaseAttempted &&
+            p.releaseWriteReturned && !p.raw;
+    }
+    // Called only AFTER real Board release returned,with actual idle/VM/fence
+    // and per-task close checked by the Ring. No cleanup after partial I/O.
+    Lease *retire(ZornGen7AppExecution26 &member,Lease *&p)
+    {
+        if(!owns(member,p) || !releaseReturned(*p))return nullptr;
+        auto *retired=p;retired->retired=true;retired->member=nullptr;
+        active_=nullptr;p=nullptr;return retired;
+    }
+    static void disposeRetired(Lease &p)
+    {
+        // Ring detaches under issuer,then drops references outside its locks.
+        p.transport->release();p.registerMaps->release();auto *retired=&p;IODelete(retired,Lease,1);
+    }
+    template<class Read,class Write,class Poll>
+    static bool request(Lease &r,Read read,Write write,Poll poll)
+    {
+        // Original K80/Gen7 direct-HFI protocol,with the caller's fresh real
+        // authority check before EACH access and original bounded poll clock.
+        constexpr uint32_t request=1u<<30,ack=1u<<31;
+        if(!read(0x1f992,r.ack) || !read(0x1f996,r.host) || (r.ack&ack) || (r.host&(request|ack)))return false;
+        if(!write(0x1f994,request))return false;r.requestReturned=true;
+        if(!poll(0x1f992,ack,ack,r.ack))return false;r.ackObserved=true;
+        if(!write(0x1f991,ack) || !read(0x1f992,r.ack) || (r.ack&ack))return false;r.ackCleared=true;
+        if(!poll(0x1f8d0,3u,0u,r.gx))return false;r.gxOn=true;
+        return true;
+    }
+    template<class Write>
+    static bool clear(Lease &r,Write write)
+    {
+        // Existing returned clear store only;no release ACK or DMA-stop claim.
+        uint32_t clear=1u<<31;r.raw=write(0x1f994,clear);r.releaseWriteReturned=!r.raw;
+        return r.releaseWriteReturned;
+    }
+public:
+    ZornGen7PhysicalOob26()=default;
+};
