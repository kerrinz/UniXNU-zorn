+enum class State { NotQualified, StartChanged, TeDetached, Disabled, Drained, TeRestored, Applied };
+struct Report {
+    State state = State::NotQualified;
+    uint32_t savedVsync = 0, lastBusy = 0, lastLine = 0, lastCounter = 0;
+    unsigned polls = 0;
+    bool keepResources = false;
+};
+
+// The actual present owner must have made BOTH buffers immutable and checked
+// that both VIG pipes address the active buffer. Port writes are restricted to
+// INTF1 TE config and autorefresh, with the live display lease held.
+template<class Port>
+Report change(Port &port, uint32_t from, uint32_t to)
+{
+    Report out;
+    uint32_t config = 0, dsi = 0, te = 0;
+    const bool legal = (from == Inherited && to == Comparison) ||
+                       (from == Comparison && to == Inherited);
+    if (!legal || !port.lease() || !port.readIntf(TearSyncVsync, out.savedVsync) ||
+        !(out.savedVsync & ExternalTe) || !port.readIntf(Cmd::AutoRefreshConfig, config) ||
+        config != from || !port.readTear(Auto::TearEnable, te) || (te & Auto::TearDoneMask) ||
+        !port.readDsi(Cmd::DsiInterrupt, dsi) || (dsi & (Cmd::DsiDoneEnabled | Cmd::DsiError))) return out;
+
+    auto writeVerify = [&](uint32_t off, uint32_t value) {
+        uint32_t readback = 0;
+        return port.lease() && port.writeIntf(off, value) && port.readIntf(off, readback) && readback == value;
+    };
+    const uint32_t detached = out.savedVsync & ~ExternalTe;
+    out.keepResources = true;
+    out.state = State::StartChanged;
+    if (!writeVerify(TearSyncVsync, detached)) return out;
+    out.state = State::TeDetached;
+    if (!writeVerify(Cmd::AutoRefreshConfig, from & ~Enabled)) return out;
+    out.state = State::Disabled;
+
+    // The vendor command encoder detaches external TE before disabling auto
+    // refresh. Treat its active write-line interval as busy as well as INTF's
+    // own auto status. Require two consecutive quiet, identical counters
+    // before the next input is armed. Never touch the debug-bus or write ptr.
+    bool previousQuiet = false;
+    const uint64_t start = port.nowUs();
+    uint64_t last = start;
+    while (out.polls < DrainPolls) {
+        port.delayMs(DrainPollMs);
+        ++out.polls;
+        const uint64_t now = port.nowUs();
+        uint32_t verifyTe = 0;
+        const uint32_t previous = out.lastCounter;
+        if (now <= last || now - start > 50000 || !port.lease() ||
+            !port.readIntf(TearSyncVsync, verifyTe) || verifyTe != detached ||
+            !port.readIntf(Cmd::AutoRefreshConfig, config) || config != (from & ~Enabled) ||
+            !port.readIntf(Cmd::AutoRefreshStatus, out.lastBusy) ||
+            !port.readIntf(Auto::WriteLine, out.lastLine) ||
+            !port.readIntf(Cmd::InterfaceFrames, out.lastCounter) ||
+            !port.readDsi(Cmd::DsiInterrupt, dsi) || (dsi & (Cmd::DsiDoneEnabled | Cmd::DsiError))) return out;
+        last = now;
+        const bool quiet = !out.lastBusy && (!out.lastLine || out.lastLine >= ZORN_SCANOUT_HEIGHT);
