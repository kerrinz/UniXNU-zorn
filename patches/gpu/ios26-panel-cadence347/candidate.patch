+    if (!writeVerify(TearSyncVsync, out.savedVsync)) return out;
+    out.state = State::TeRestored;
+    if (!writeVerify(Cmd::AutoRefreshConfig, to)) return out;
+    out.state = State::Applied;
+    // This completed MMIO step alone cannot authorize dropping the owner.
+    // A caller must observe fresh DSI completion and eventually restore the
+    // retained mode or intentionally keep owning the live scanout.
+    return out;
+}
