+ bool install(uint64_t id,uintptr_t current,uint32_t method,bool closing,bool count){
+  auto*s=token(id);if(!s)return refuse(current);const auto done=completion(*s);
+  if(done && !(method==ZornFailurePhysicalMethod261 && (done&1u) && uint32_t(done>>32)))return refuse(current);
