+class ZornClientFailureStore261 {
+ struct Slot {uintptr_t owner=0;uint64_t identity=0,completion=0;uint32_t events=0;ZornClientFailure261 record{};};
+ struct Scope {uintptr_t thread=0;uint64_t token=0;uint32_t method=0;};
+ Slot slots_[ZornFailureSlots261]{};Scope scopes_[ZornFailureSlots261]{};
