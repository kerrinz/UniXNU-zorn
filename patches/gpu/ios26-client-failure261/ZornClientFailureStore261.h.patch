+ void unlock(){__atomic_store_n(&gate_,0u,__ATOMIC_RELEASE);}
+ void drop(){__atomic_fetch_add(&dropped_,1u,__ATOMIC_RELAXED);}
+ static uintptr_t scopeThread(const Scope&s){return __atomic_load_n(&s.thread,__ATOMIC_ACQUIRE);}
+ static uint64_t scopeToken(const Scope&s){return __atomic_load_n(&s.token,__ATOMIC_ACQUIRE);}
+ static uint32_t scopeMethod(const Scope&s){return __atomic_load_n(&s.method,__ATOMIC_ACQUIRE);}
+ static uint64_t completion(const Slot&s){return __atomic_load_n(&s.completion,__ATOMIC_ACQUIRE);}
+ Slot *token(uint64_t id){if(!id)return nullptr;auto&s=slots_[id&63u];return __atomic_load_n(&s.identity,__ATOMIC_ACQUIRE)==id?&s:nullptr;}
+ uintptr_t thread(const Slot&s)const{const auto id=__atomic_load_n(&s.identity,__ATOMIC_ACQUIRE);for(const auto&scope:scopes_)if(scopeToken(scope)==id&&scopeThread(scope))return scopeThread(scope);return 0;}
