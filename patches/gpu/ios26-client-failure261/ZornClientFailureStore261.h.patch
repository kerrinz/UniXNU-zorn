+ }
+ void targetEnd(uintptr_t current,const ZornClientFailureScope261&saved){
+  revoke(current);if(!saved.hadPrevious)return;if(!lock()){drop();return;}
+  (void)install(saved.previousToken,current,saved.previousMethod,false,false);unlock();
+ }
+ void noteThread(uintptr_t current,uint32_t stage,uint32_t raw,uint32_t kind,uint32_t reason,uint32_t a,uint32_t b){
+  if(!current)return;if(!lock()){drop();return;}const Scope*found=nullptr;
+  for(const auto&s:scopes_)if(scopeThread(s)==current){if(found){drop();unlock();return;}found=&s;}
+  if(found){auto*s=token(scopeToken(*found));if(s&&(!completion(*s)||(scopeMethod(*found)==ZornFailurePhysicalMethod261&&(completion(*s)&1u)&&uint32_t(completion(*s)>>32))))note(*s,scopeMethod(*found),stage,raw,kind,reason,a,b);}unlock();
+ }
+ void noteClient(uintptr_t owner,uint64_t id,uint32_t stage,uint32_t raw,uint32_t kind,uint32_t reason,uint32_t a,uint32_t b){
+  if(!owner||!id)return;if(!lock()){drop();return;}auto*s=token(id);
+  if(s&&s->owner==owner&&!completion(*s))note(*s,0,stage,raw,kind,reason,a,b);unlock();
+ }
+ void finish(uint64_t id,uint32_t raw){
+  auto*s=token(id);if(!s)return;if(thread(*s)){drop();return;}
+  uint64_t expected=0;if(!__atomic_compare_exchange_n(&s->completion,&expected,UINT64_C(2),false,__ATOMIC_ACQ_REL,__ATOMIC_RELAXED)){drop();return;}
+  if(lock()){
