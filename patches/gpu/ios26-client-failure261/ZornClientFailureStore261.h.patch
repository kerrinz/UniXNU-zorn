+  for(unsigned i=0;i<ZornFailureSlots261;++i)if(!slots_[i].record.id){chosen=&slots_[i];index=i;break;}
+  if(!chosen)for(unsigned i=0;i<ZornFailureSlots261;++i)if(completion(slots_[i])==1&&!thread(slots_[i])){chosen=&slots_[i];index=i;break;}
