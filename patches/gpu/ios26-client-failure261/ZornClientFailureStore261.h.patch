+public:
+ uint64_t bind(uintptr_t owner,uint64_t unique,uint32_t pid){
+  if(!owner||!unique||!pid)return 0;if(!lock()){drop();return 0;}
+  for(auto&s:slots_)if(s.owner==owner&&(!completion(s)||uint32_t(completion(s)>>32))){drop();unlock();return 0;}
