+  for(auto&s:scopes_)if(scopeToken(s)==id){uintptr_t expected=current;if(__atomic_compare_exchange_n(&s.thread,&expected,uintptr_t(0),false,__ATOMIC_ACQ_REL,__ATOMIC_RELAXED))cleared=true;}
+  if(!cleared)drop();
+ }
+ void targetBegin(uint64_t id,uintptr_t current,ZornClientFailureScope261&saved){
+  saved={};if(!current)return;
+  // Read only atomic CPU scope fields. Revocation never waits for the writer
+  // gate,so a failed diagnostic switch cannot retain caller attribution.
+  for(const auto&s:scopes_)if(scopeThread(s)==current){
+   if(saved.hadPrevious){saved={};revoke(current);drop();return;}
+   saved.previousToken=scopeToken(s);saved.previousMethod=scopeMethod(s);saved.hadPrevious=1;
+  }
