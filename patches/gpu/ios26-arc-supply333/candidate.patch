+++ b/arc-runtime/ZornGen7CoreSupplyPresence333.h
@@ -0,0 +1,42 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#pragma once
+
+#include "ZornGen7CoreSourceMetadata.inc"
+
+namespace ZornGen7CoreSourceMetadata {
+struct SupplyPresence {
+    unsigned char masks[group_count]{};
+};
+
+constexpr bool supplyCountsFit()
+{
+    for (size_t count : counts) {
+        if (count > 8) return false;
+    }
+    return true;
+}
+
+static_assert(sizeof(counts) / sizeof(counts[0]) == group_count);
+static_assert(supplyCountsFit());
+
+// Keep the native metadata as the only source of supply relationships.
+// Startup needs presence only, so it does not load metadata pointers at runtime.
+constexpr SupplyPresence supplyPresence = [] {
+    SupplyPresence presence{};
+    for (size_t group = 0; group < group_count; ++group) {
+        for (size_t voter = 0; voter < counts[group]; ++voter) {
+            if (groups[group][voter].upstream) {
+                presence.masks[group] |= static_cast<unsigned char>(1u << voter);
+            }
+        }
+    }
+    return presence;
+}();
+
+inline bool readSupplyPresence(size_t group, size_t voter, bool &hasUpstream)
+{
+    if (group >= group_count || voter >= counts[group]) return false;
+    hasUpstream = (supplyPresence.masks[group] & (1u << voter)) != 0;
+    return true;
+}
+}
