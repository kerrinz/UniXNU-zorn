+// Access to the row cursor is serialized by the existing helper lock.
+// A participant can join only while there are rows it can claim.
+struct RowClaims {
+    static constexpr int32_t RowsPerClaim = 128;
+    int32_t next = 0, end = 0;
+
+    bool available() const { return next < end; }
+    bool take(int32_t &first, int32_t &last) {
+        if (!available()) return false;
+        first = next;
+        next += end - next < RowsPerClaim ? end - next : RowsPerClaim;
+        last = next;
+        return true;
+    }
+};
 
