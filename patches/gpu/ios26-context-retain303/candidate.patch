+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#pragma once
+#include <stdint.h>
+
+// Retain the currently selected healthy application SMMU context (s.processSelected)
+// across successful Map (BoMap/BoFree), Submit (Submit/SubmitBatch), and Wait (WaitFence,
+// both completed and healthy timeout) operations instead of executing RestoreKernel after
+// every operation, which forced the next operation of the same process to re-execute
+// Select -> ZornGen7HostGpuTables26::selectProcessTables -> p.vm_.auditLive() (~10ms full
+// 400+ MiB PTE walk + Adreno CP context reset).
+// Cross-client handover (enterApplicationContext / PrepareTables), Close, OobRelease, and
+// all error paths continue to drain and execute RestoreKernel identically.
+template <typename OpEnum>
+constexpr inline bool zorn26_retain_application_context303(
+    int raw, bool waitExpired, OpEnum kind, bool operationHeld, bool healthy)
+{
+    return (!raw || waitExpired) && operationHeld && healthy &&
+           (kind == OpEnum::Map || kind == OpEnum::Submit || kind == OpEnum::Wait);
+}
