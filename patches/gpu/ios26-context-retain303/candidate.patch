+
+void ZornGen7HostRing26::awaitApplicationLatestFenceIrq303(uint64_t timeoutNs)
+{
+    if(!storage_ || !normal() || !timeoutNs)return;
+    auto &s=*storage_;
+    if(IORecursiveLockHaveLock(&s.gate) || s.issuerHeld() || s.appSerialHeld())return;
+    if(__atomic_load_n(&s.phase,__ATOMIC_ACQUIRE)<6 ||
+       !__atomic_load_n(&s.runtimeReady,__ATOMIC_ACQUIRE) ||
+       __atomic_load_n(&s.stopped,__ATOMIC_ACQUIRE))return;
+    uint32_t target=0;
+    s.lockIssuer();
+    if(s.runtimeReady && bootstrapHealthy() && !s.native.poisoned()){
+        const uint32_t issued=s.native.lastSubmitted();
+        if(issued>s.native.completedFence())target=issued;
+    }
+    s.unlockIssuer();
+    if(target)(void)awaitApplicationFenceIrq299(target,timeoutNs);
 }
 
