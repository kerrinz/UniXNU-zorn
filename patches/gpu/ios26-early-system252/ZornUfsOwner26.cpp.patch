+static void zorn_gpu_early_worker252(void *context,wait_result_t) {
+ auto *owner=static_cast<ZornUfsOwner26 *>(context);
+ bool entered=false;
+ if(zorn_early_mode252()==1 && preemption_enabled() && !ml_at_interrupt_context() && ml_get_interrupts_enabled()){
