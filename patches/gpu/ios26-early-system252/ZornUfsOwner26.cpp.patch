+  const bool ready=zorn_gpu_early_wait252(deadline,zorn26_gmu_deferred_ready252,
+      [](){return mach_absolute_time();},[](){IOSleep(10);});
+  if(ready && owner->readStatus().phase==ZornUfsOwner26::Phase::RootRegistered){
+   __atomic_store_n(&zornEarlyTicks252,mach_absolute_time(),__ATOMIC_RELEASE);
+   __atomic_fetch_or(&zornEarlyFlags252,4u,__ATOMIC_RELEASE);
+   Hjt26Reason milestone={};
+   char text[sizeof(milestone.record.text)]{};
+   const unsigned online=__atomic_load_n(&processor_avail_count,__ATOMIC_RELAXED);
+   const int n=snprintf(text,sizeof(text),"K80 GPU early252: root=1; deferred=1; cpu_online=%u; cpu_samples=pending",online);
+   if(n>0 && size_t(n)<sizeof(text)){
+    hjt26_capture(&milestone,text,kZornPlatformRecordTrial);
+    ZornUfsCore26::PlatformRecordObservation observed{};
+    const auto raw=ZornUfsCore26::persistPlatformRecordOnce(milestone.record,observed);
+    if(!raw && observed.writeReturned && observed.readbackReturned && observed.readbackMatched){
+     __atomic_fetch_or(&zornEarlyFlags252,8u|16u,__ATOMIC_RELEASE);
+     // Original physical CDC identity/route check and three actually completed
+     // frames still precede the original worker and every diagnostic handshake.
+     entered=true;__atomic_fetch_or(&zornEarlyFlags252,32u,__ATOMIC_RELEASE);
+     zorn_gpu_progress_cdc201(owner);
+    }
+   }
+  }
+ }
+ if(!entered)__atomic_fetch_or(&zornEarlyFlags252,0x80000000u,__ATOMIC_RELEASE);
+ owner->release();
+ (void)thread_terminate(current_thread());panic("K80 early GPU worker termination returned");
+}
+static void zorn_gpu_early_schedule252(ZornUfsOwner26 *owner){
+ unsigned empty=0;
+ if(!owner || zorn_early_mode252()!=1 ||
+    !__atomic_compare_exchange_n(&zornEarlyFlags252,&empty,1u,false,__ATOMIC_ACQ_REL,__ATOMIC_ACQUIRE))return;
+ owner->retain();thread_t worker=THREAD_NULL;
+ const auto raw=kernel_thread_start(zorn_gpu_early_worker252,owner,&worker);
+ if(raw==KERN_SUCCESS && worker!=THREAD_NULL){
+  __atomic_fetch_or(&zornEarlyFlags252,2u,__ATOMIC_RELEASE);thread_deallocate(worker);
+ }else{
+  __atomic_fetch_or(&zornEarlyFlags252,0x80000000u,__ATOMIC_RELEASE);
+  if(raw!=KERN_SUCCESS)owner->release();
+  // Success without a handle may still have a running worker: retain and do
+  // not retry, reroute CDC or infer it never ran.
+ }
+}
 
