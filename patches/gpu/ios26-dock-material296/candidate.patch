+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#pragma once
+#include "ZornSerialShot270.h"
+
+// Use the same bounded immutable payload as SHOT270. A wider sample of the
+// bottom quarter retains Dock pixels and the adjacent wallpaper.
+struct ZornSerialDock296 {
+    using Shot = ZornSerialShot<104, 48>;
+    enum { Bytes=Shot::Bytes, PacketHeader=68 };
+
+private:
+    Shot image_;
+    uint32_t publication_=0,roi_[4]{};
+
+public:
+    bool request(){return image_.request();}
+    bool pending()const{
+        return __atomic_load_n(&image_.state,__ATOMIC_ACQUIRE)==1 &&
+               __atomic_load_n(&publication_,__ATOMIC_ACQUIRE)==0;
+    }
+    bool ready()const{return __atomic_load_n(&publication_,__ATOMIC_ACQUIRE)==2 && image_.ready();}
+    bool capture(const volatile uint32_t *base,uint32_t w,uint32_t h,uint32_t stride,
+                 size_t available,const uint32_t (&record)[16]){
+        const uintptr_t address=reinterpret_cast<uintptr_t>(base);
+        const uint64_t extent=uint64_t(stride)*h;
+        if(!base || (address&3u) || w<104 || h<192 || (h&3u) || w>16384 || h>16384 ||
+           (stride&3u) || uint64_t(stride)<uint64_t(w)*4 || !extent || extent>available ||
+           extent-1>UINTPTR_MAX-address)return false;
+        uint32_t empty=0;
+        if(!__atomic_compare_exchange_n(&publication_,&empty,1u,false,__ATOMIC_ACQ_REL,__ATOMIC_ACQUIRE))return false;
+        const uint32_t rows=h/4,y=h-rows;
+        const size_t offset=size_t(y)*stride;
+        roi_[0]=0;roi_[1]=y;roi_[2]=w;roi_[3]=rows;
+        const auto *crop=reinterpret_cast<const volatile uint32_t *>(
+            reinterpret_cast<const volatile uint8_t *>(base)+offset);
+        const bool ok=image_.capture(crop,w,rows,stride,available-offset,record);
+        __atomic_store_n(&publication_,ok?2u:0u,__ATOMIC_RELEASE);
+        return ok;
+    }
+    unsigned packet(char *out,unsigned cap,unsigned offset,const uint8_t (&tag)[16])const{
+        if(!out || cap>3072 || cap<=PacketHeader || !ready())return 0;
+        const unsigned n=image_.packet(out,cap-20,offset,tag);
+        if(n<=48)return 0;
+        memmove(out+PacketHeader,out+48,n-48);
+        memcpy(out,"K80SH296",8);
+        auto *p=reinterpret_cast<uint8_t *>(out);
+        zorn_panic_le236(p,44,296);
+        for(unsigned i=0;i<4;++i)zorn_panic_le236(p,48+4*i,roi_[i]);
+        zorn_panic_le236(p,64,zorn_panic_crc236(p,64));
+        return n+20;
+    }
+};
