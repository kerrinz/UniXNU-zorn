diff -ruN a/ZornPresenterScope298.h b/ZornPresenterScope298.h
--- a/ZornPresenterScope298.h	1970-01-01 08:00:00
+++ b/ZornPresenterScope298.h	2026-11-18 12:09:44
@@ -0,0 +1,100 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#pragma once
+#include <stdint.h>
+
+struct ZornPresenterOutcome298 {
+    bool completed = false;
+    bool terminal = false;
+    bool copied = false;
+    bool readable = false;
+    uint32_t record[16]{};
+};
+
+// Acquire surface caches and snapshot the completion ledger under the GPU
+// presentation lease, then release issuer + presentationRegistry BEFORE the
+// full-screen CPU panel copy (show) on GPU frames (lease.gpu() == true).
+// Early CPU-only frames (!lease.gpu()) retain the registry lease across show().
+template <unsigned Layers, typename Lease, typename Surface, typename Clock, typename Cost,
+          typename AcquireFn, typename LedgerFn, typename SurfaceFenceFn,
+          typename CounterFn, typename ShowFn>
+inline ZornPresenterOutcome298 zorn26_present_frame298(
+    uint32_t frameId,
+    uint32_t producerFence,
+    uint32_t width,
+    uint32_t height,
+    Surface *const (&surfaces)[Layers],
+    uint64_t &leaseObserved,
+    Clock &clock,
+    Cost &cost,
+    AcquireFn &&acquireSurface,
+    LedgerFn &&readLedger,
+    SurfaceFenceFn &&readSurfaceFence,
+    CounterFn &&readPresentCounter,
+    ShowFn &&runShow)
+{
+    ZornPresenterOutcome298 out{};
+    bool leaseGpu = false;
+    uint32_t tail = 0, retired = 0, count = 0, firstSid = 0, firstFence = 0;
+    bool ledger = false;
+    uint64_t before = 0, after = 0;
+    {
+        const uint64_t leaseBegan = clock.now();
+        cost.attempt();
+        Lease lease(producerFence);
+        out.readable = lease.ready();
+        leaseGpu = lease.gpu();
+        out.terminal = lease.failed();
+        const uint64_t leaseEnded = clock.now();
+        cost.measure(Cost::LeaseCall, leaseBegan, leaseEnded, clock);
+        cost.measure(Cost::LeaseWall, leaseObserved, leaseEnded, clock);
+        leaseObserved = leaseEnded;
+        const uint64_t acquireBegan = clock.now();
+        if (out.readable && leaseGpu) {
+            for (unsigned layer = 0; layer < Layers; ++layer) {
+                if (surfaces[layer] && !acquireSurface(surfaces[layer])) {
+                    out.readable = false;
+                    out.terminal = true;
+                    break;
+                }
+            }
+        }
+        cost.measure(Cost::Acquire, acquireBegan, clock.now(), clock);
+        if (out.readable) {
+            ledger = leaseGpu && readLedger(&tail, &retired);
+            for (unsigned i = 0; i < Layers; ++i) {
+                if (surfaces[i]) {
+                    if (!count) firstSid = surfaces[i]->sid;
+                    ++count;
+                }
+            }
+            firstFence = (count && leaseGpu) ? readSurfaceFence(firstSid) : 0;
+            if (!leaseGpu) {
+                before = readPresentCounter();
+                const uint64_t showBegan = clock.now();
+                runShow();
+                out.completed = true;
+                cost.measure(Cost::Show, showBegan, clock.now(), clock);
+                after = readPresentCounter();
+            }
+        }
+    }
+    if (out.readable && leaseGpu) {
+        before = readPresentCounter();
+        const uint64_t showBegan = clock.now();
+        runShow();
+        out.completed = true;
+        cost.measure(Cost::Show, showBegan, clock.now(), clock);
+        after = readPresentCounter();
+    }
+    if (out.readable) {
+        out.copied = after > before;
+        const uint32_t rec[16] = {
+            2u, frameId, producerFence, leaseGpu ? 2u : 1u,
+            tail, retired, count, firstSid,
+            leaseGpu ? 1u : 0u, out.copied ? 1u : 0u, ledger ? 1u : 0u,
+            uint32_t(before), uint32_t(after), width, height, firstFence
+        };
+        for (unsigned i = 0; i < 16; ++i) out.record[i] = rec[i];
+    }
+    return out;
+}
