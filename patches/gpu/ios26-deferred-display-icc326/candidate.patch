+IOReturn ZornGen7IccVoter26::prepareDisplayRegisterBandwidth(IORecursiveLock *startup)
+{
+    if (!sourceReady() || !normal() || !startup || !IORecursiveLockHaveLock(startup)) return kIOReturnNotReady;
+    auto &s = *storage_;
+    if (!s.recommitReady || s.displayGraphAttempted || !s.rsc.forwardAllowed()) return kIOReturnNotReady;
+    s.displayGraphAttempted = true;
+    IORecursiveLockLock(s.domainGate);
+    auto finish = [&](IOReturn result) { IORecursiveLockUnlock(s.domainGate); return result; };
+    // No BCM sends occur in this graph construction. The live voter sees
+    // only its four existing bindings until every display object is attached.
+    if (!prepareGraphSlice(Source::gpu_startup_provider_count, Source::provider_count,
+                           Source::gpu_startup_node_count, Source::node_count,
+                           Source::gpu_startup_bcm_count, Source::bcm_count)) return finish(kIOReturnNotReady);
+    NativePath *path = nullptr;
+    s.displayBandwidth = s.bindPath(Source::display_path, Source::display_path_count, s.displayRequests, path);
+    if (!s.displayBandwidth || !s.rsc.forwardAllowed()) return finish(kIOReturnNotReady);
+    s.transport.binding_count = Source::bcm_count;
+    return finish(kIOReturnSuccess);
+}
