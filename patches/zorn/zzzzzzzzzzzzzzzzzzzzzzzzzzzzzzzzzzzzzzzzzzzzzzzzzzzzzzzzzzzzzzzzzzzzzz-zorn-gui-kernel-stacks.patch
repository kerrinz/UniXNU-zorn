+#include <arm/machine_routines.h>
+
+/* No task/thread lock is held. On the sole initialized CPU, disabling
+ * preemption keeps a referenced, non-running target's wired stack stable.
+ * No waits, suspension, filesystem I/O or persistent logging occur here. */
+#include <sys/zorn_gui_log.h>
+static __attribute__((noinline)) int
+zorn_gui_sample_kernel_stack(const char *name, int pid, thread_t target)
+{
+    struct ZornGuiUserStack stack = {.pid = (uint32_t)pid};
+    kern_return_t error = KERN_FAILURE;
+    bool user_preferred = false;
+    disable_preemption();
+    if (processor_count != 1) {
+        error = KERN_NOT_SUPPORTED;
+    } else if (target != THREAD_NULL && target != current_thread() &&
+        (target->state & TH_WAIT) && !(target->state & (TH_RUN | TH_TERMINATE))) {
+        if (target->continuation != NULL) {
+            /* The continuation is already in the process record. Preserve
+             * the deeper user call chain instead of duplicating one PC. */
+            user_preferred = true;
+        } else {
+            uint64_t base = target->kernel_stack, size = kernel_stack_size;
+            uint64_t saved = (uintptr_t)target->machine.kstackptr;
+            arm_kernel_saved_state_t state;
+            error = KERN_INVALID_ADDRESS;
+            if (base && size >= sizeof(state) && size <= 1024 * 1024 &&
+                saved >= base && saved - base <= size - sizeof(state) &&
+                ml_nofault_copy(saved, (vm_offset_t)&state, sizeof(state)) == sizeof(state) &&
+                !state.pc_was_in_userspace) {
+                error = KERN_SUCCESS;
+                if (state.lr >= VM_MIN_KERNEL_ADDRESS && state.lr <= VM_MAX_KERNEL_ADDRESS)
+                    stack.frames[stack.count++] = state.lr;
+                uint64_t fp = state.fp;
+                while (fp && stack.count < ZORN_GUI_STACK_FRAMES) {
+                    uint64_t pair[2] = {0};
+                    if (!zorn_gui_kernel_frame_valid(base, size, fp) ||
+                        ml_nofault_copy(fp, (vm_offset_t)pair, sizeof(pair)) != sizeof(pair)) {
+                        error = KERN_INVALID_ADDRESS;
+                        break;
+                    }
+                    if (pair[1] < VM_MIN_KERNEL_ADDRESS || pair[1] > VM_MAX_KERNEL_ADDRESS) {
+                        error = KERN_INVALID_ADDRESS;
+                        break;
+                    }
+                    stack.frames[stack.count++] = pair[1];
+                    if (!pair[0]) break;
+                    if (pair[0] <= fp) { error = KERN_INVALID_ADDRESS; break; }
+                    fp = pair[0];
+                }
+            }
+        }
+    } else if (target != THREAD_NULL && target != current_thread() &&
+        !(target->state & TH_TERMINATE)) {
+        user_preferred = true;
+    }
+    enable_preemption();
+    if (user_preferred) return 0;
+    stack.error = ZORN_GUI_STACK_KERNEL | (uint32_t)error;
+    zorn_ufs_gui_stack(name, &stack);
+    return 1;
+}
