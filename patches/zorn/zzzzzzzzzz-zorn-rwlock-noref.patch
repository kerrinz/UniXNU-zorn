 }
 
+/*
+ * Same initial lock word as lck_rw_init(), without the group reference.
+ * That reference is an ldxr/stxr increment, and it does not finish while
+ * the user pmap is being created.
+ */
+void
+lck_rw_init_noref(
+	lck_rw_t        *lck,
+	lck_attr_t      *attr)
+{
+	lck_type_t type = LCK_TYPE_RW;
+
+	if (attr == LCK_ATTR_NULL) {
+		attr = &lck_attr_default;
+	}
+	*lck = (lck_rw_t){
+		.lck_rw_type = type,
+		.lck_rw_can_sleep = true,
+		.lck_rw_priv_excl = !(attr->lck_attr_val & LCK_ATTR_RW_SHARED_PRIORITY),
+	};
+}
