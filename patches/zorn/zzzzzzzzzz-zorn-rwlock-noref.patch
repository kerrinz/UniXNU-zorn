@@ -746,10 +768,19 @@ lck_rw_interlock_spin(
 	lck_rw_t        *lock)
 {
 	uint32_t        data, prev;
+	int             spins = 0;
+	extern volatile int zorn_read_trace;
+	extern void zorn_say(const char *);
 
 	for (;;) {
 		data = atomic_exchange_begin32(&lock->lck_rw_data, &prev, memory_order_relaxed);
 		if (data & LCK_RW_INTERLOCK) {
+			if (zorn_read_trace && ++spins > 8) {
+				atomic_exchange_abort();
+				*(volatile uint32_t *)&lock->lck_rw_data = data & ~LCK_RW_INTERLOCK;
+				zorn_say("LRIN");
