 {
+	extern volatile int zorn_read_trace;
+	extern void zorn_say(const char *);
+
+	if (zorn_read_trace) {
+		zorn_say("LRDE");
+	}
 	(void) lck_rw_lock_exclusive_internal_inline(lock, __builtin_return_address(0), NULL);
+	if (zorn_read_trace) {
+		extern volatile int zorn_read_irqs_on;
+		unsigned long long caller;
+		char word[10];
+		static const char hex[] = "0123456789ABCDEF";
+		int i;
+
+		zorn_say("LRDK");
+		zorn_say("LROK");
+		caller = (unsigned long long)__builtin_return_address(0);
+		word[0] = 'C';
+		for (i = 8; i >= 1; i--) {
+			word[i] = hex[caller & 0xfull];
+			caller >>= 4;
+		}
+		word[9] = '\0';
+		zorn_read_irqs_on = 1;
+		zorn_say(word);
+	}
 }
 
