 static void
+zorn_gui_library_paths(void)
+{
+	static const char *paths[] = {
+		"/usr/lib/libobjc-trampolines.dylib",
+		"/private/preboot/usr/lib/libobjc-trampolines.dylib",
+		"/System/Library/Caches/com.apple.dyld/dyld_shared_cache_arm64",
+		"/private/preboot/System/Library/Caches/com.apple.dyld/dyld_shared_cache_arm64",
+	};
+	uint32_t results[8];
+	for (unsigned i = 0; i < 8; ++i) results[i] = UINT32_MAX;
+	zorn_ufs_gui_paths(results);
+	for (unsigned i = 0; i < 4; ++i) {
+		vnode_t vp = NULLVP;
+		int error = vnode_lookup(paths[i], 0, &vp, vfs_context_current());
+		results[2 * i] = (uint32_t)error;
+		results[2 * i + 1] = error ? 0 : (uint32_t)vnode_vtype(vp);
+		if (!error) vnode_put(vp);
+		zorn_ufs_gui_paths(results);
+	}
+}
