+#if defined(XNU_NATIVE_RAM_BLOCK) && XNU_NATIVE_RAM_BLOCK
+/* Exercise only the independently identified, volatile Data mount. Normal
+ * vnode authorization and APFS code perform every operation; no raw media
+ * writes or authorization overrides are used. */
+static int
+native_owner_data_probe(proc_t p, user_addr_t scratch, mount_t data_mount)
+{
+	char path[96];
+	uint64_t probe_nonce = mach_absolute_time();
+	vfs_context_t ctx = vfs_context_current();
+	vnode_t vp = NULLVP;
+	uint8_t expected[64], observed[64] = {0};
+	int error, close_error, residue = 0, created = 0;
+	int flags = FREAD | FWRITE;
+	int32_t result = 0;
+	struct unlink_args remove = {.path = scratch + 0x100};
+	for (unsigned i = 0; i < sizeof(expected); ++i)
+		expected[i] = (uint8_t)(0xa5 ^ i ^ zorn_data_expected_seed[i % 32]);
+	if ((error = vnode_lookup("/private/var/tmp", 0, &vp, ctx))) goto done;
+	if (vnode_mount(vp) != data_mount || !vnode_isdir(vp)) error = EXDEV;
+	vnode_put(vp); vp = NULLVP;
+	if (error) goto done;
+	native_owner_data_probe_stage = 1;
+	for (unsigned attempt = 0; attempt < 8; ++attempt) {
+		snprintf(path, sizeof(path), "/private/var/tmp/.zorn-data-probe-%llx-%u", probe_nonce, attempt);
+		if ((error = copyout(path, remove.path, strlen(path) + 1))) goto done;
+		error = vnode_open(path, flags | O_CREAT | O_EXCL | O_NOFOLLOW, 0600, 0, &vp, ctx);
+		if (error != EEXIST) break;
+	}
+	if (error) goto done;
+	created = 1;
+	if (vnode_mount(vp) != data_mount || !vnode_isreg(vp)) { error = EXDEV; goto close_file; }
+	native_owner_data_probe_stage = 2;
+	error = vn_rdwr(UIO_WRITE, vp, (caddr_t)expected, sizeof(expected), 0,
+	    UIO_SYSSPACE, IO_SYNC | IO_NOCACHE | IO_UNIT, vfs_context_ucred(ctx), &residue, p);
+	if (!error && residue) error = EIO;
+	if (!error) {
+		native_owner_data_probe_stage = 3;
+		error = VNOP_FSYNC(vp, MNT_WAIT, ctx);
+	}
+close_file:
+	close_error = vnode_close(vp, flags, ctx); vp = NULLVP;
+	if (!error) error = close_error;
+	if (error) goto done;
+	native_owner_data_probe_stage = 4;
+	flags = FREAD;
+	if ((error = vnode_open(path, flags | O_NOFOLLOW, 0, 0, &vp, ctx))) goto done;
+	if (vnode_mount(vp) != data_mount || !vnode_isreg(vp)) error = EXDEV;
+	if (!error) {
+		native_owner_data_probe_stage = 5;
+		residue = 0;
+		error = vn_rdwr(UIO_READ, vp, (caddr_t)observed, sizeof(observed), 0,
+		    UIO_SYSSPACE, IO_NOCACHE, vfs_context_ucred(ctx), &residue, p);
+		if (!error && (residue || memcmp(expected, observed, sizeof(expected)))) error = EIO;
+	}
+	close_error = vnode_close(vp, flags, ctx); vp = NULLVP;
+	if (!error) error = close_error;
+done:
+	if (created) {
+		int remove_error = unlink(p, &remove, &result);
+		if (!error) {
+			native_owner_data_probe_stage = 6;
+			error = remove_error;
+			if (!error) {
+				int lookup_error = vnode_lookup(path, VNODE_LOOKUP_NOFOLLOW, &vp, ctx);
+				if (!lookup_error) { vnode_put(vp); vp = NULLVP; }
+				error = lookup_error == ENOENT ? 0 : (lookup_error ? lookup_error : EEXIST);
+				if (!error) native_owner_data_probe_stage = 7;
+			}
+		}
+	}
+	native_owner_data_probe_status = error;
+	return error;
+}
+#endif
 
