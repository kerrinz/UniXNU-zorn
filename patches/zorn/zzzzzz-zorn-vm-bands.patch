@@ -1816,6 +1823,35 @@
 
 #define ARM64_PHYSMAP_SLIDE_RANGE (1ULL << 30) // 1 GB
 #define ARM64_PHYSMAP_SLIDE_MASK  (ARM64_PHYSMAP_SLIDE_RANGE - 1)
+
+/*
+ * Repaint the top framebuffer band through the bootstrap V=P map.
+ * Blue, yellow, magenta and orange mark the steps inside the physical
+ * aperture setup. White means that returned and the translation-table
+ * switch is next. A store after that switch may no longer reach this panel.
+ */
+static void
+zorn_vm_band(boot_args *args, uint32_t color)
+{
+	uintptr_t base;
+	uint64_t row;
+	uint64_t bytes;
+	uint64_t off;
+
+	if (args->Video.v_baseAddr == 0 || args->Video.v_rowBytes < 8 || args->Video.v_height < 16) {
+		return;
+	}
+	row = args->Video.v_rowBytes;
+	bytes = (args->Video.v_height >> 4) * row;
+	base = (uintptr_t)args->Video.v_baseAddr;
+	for (off = 0; off + 8 <= bytes; off += 8) {
+		*(volatile uint64_t *)(base + off) = ((uint64_t)color << 32) | color;
+	}
+	for (off = 0; off + 64 <= bytes; off += 64) {
+		__asm__ volatile("dc civac, %0" :: "r"(base + off) : "memory");
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
 
