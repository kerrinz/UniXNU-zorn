+static void
+zorn_draw_char(uintptr_t base, int row_bytes, int x, int y, int scale, const uint8_t *glyph)
+{
+	const uint32_t on = 0xFFFFFFFF;
+	const uint32_t off = 0xFF000000;
+	int row;
+	int sy;
+	int col;
+
+	for (row = 0; row < 7; row++) {
+		uint8_t bits = glyph ? glyph[row] : 0;
+
+		for (sy = 0; sy < scale; sy++) {
+			volatile uint32_t *pixel = (volatile uint32_t *)(base +
+			    (uintptr_t)(y + row * scale + sy) * row_bytes + (uintptr_t)x * 4);
+
+			for (col = 0; col < 6 * scale; col++) {
+				int bit = col / scale;
+				uint32_t color = off;
+
+				if (bit < 5 && (bits & (0x10 >> bit))) {
+					color = on;
+				}
+				pixel[col] = color;
+			}
+		}
+	}
+}
+
+static void
+zorn_draw_text(uintptr_t base, int row_bytes, int *x, int y, int scale, const char *text)
+{
+	const char *cursor;
+
+	for (cursor = text; *cursor != '\0'; cursor++) {
+		zorn_draw_char(base, row_bytes, *x, y, scale, zorn_glyph_for(*cursor));
+		*x += 6 * scale;
+	}
+}
+
+static void
+zorn_say_flush(uintptr_t base, int row_bytes, int y, int scale)
+{
+	int row;
+	int byte;
+
+	for (row = 0; row < 7 * scale; row++) {
+		uintptr_t line = base + (uintptr_t)(y + row) * row_bytes;
+
+		for (byte = 0; byte < row_bytes; byte += 64) {
+			__asm__ volatile("dc civac, %0" :: "r"(line + byte) : "memory");
+		}
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+void
+zorn_say(const char *text)
+{
+	static int zorn_say_x = 40;
+	static int zorn_say_y = 820;
+	const int scale = 5;
+	const int cell = 6 * scale;
+	const int x_left = 40;
+	const int x_right = 1400;
+	const char *sep = " | ";
+	uintptr_t base = 0xFC400000;
+	const int row_bytes = 5760;
+	const char *cursor;
+	int width = 0;
+
+	if (text == NULL || *text == '\0' || zorn_say_y > 3000) {
+		return;
+	}
+	for (cursor = text; *cursor != '\0'; cursor++) {
+		width += cell;
+	}
+	if (zorn_say_x != x_left && zorn_say_x + 3 * cell + width > x_right) {
+		zorn_say_x = x_left;
+		zorn_say_y += 7 * scale + 8;
+		if (zorn_say_y > 3000) {
+			return;
+		}
+	}
+	if (zorn_say_x != x_left) {
+		zorn_draw_text(base, row_bytes, &zorn_say_x, zorn_say_y, scale, sep);
+	}
+	zorn_draw_text(base, row_bytes, &zorn_say_x, zorn_say_y, scale, text);
+	zorn_say_flush(base, row_bytes, zorn_say_y, scale);
+}
