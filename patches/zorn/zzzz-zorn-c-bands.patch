+static const uint8_t *
+zorn_glyph_for(char ch)
+{
+	if (ch >= 'a' && ch <= 'z') {
+		ch = (char)(ch - 'a' + 'A');
+	}
+	if (ch >= 'A' && ch <= 'Z') {
+		return zorn_glyph_az[ch - 'A'];
+	}
+	if (ch >= '0' && ch <= '9') {
+		return zorn_glyph_09[ch - '0'];
+	}
+	if (ch == '|') {
+		return zorn_glyph_bar;
+	}
+	return NULL;
+}
