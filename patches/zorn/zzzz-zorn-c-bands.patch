+volatile int zorn_daif_held;
+volatile uint64_t zorn_saved_daif;
+
+void
+zorn_show_words(const char *text)
+{
+	uintptr_t base = 0xFC400000;
+	const int row_bytes = 5760;
+	const int scale = 1;
+	int y = 840;
+	int x = 8;
+	int row;
+	int col;
+	const char *cursor;
+
+	if (text == NULL || text[0] == '\0') {
+		return;
+	}
+	for (row = 840; row < 896; row++) {
+		volatile uint32_t *pixel = (volatile uint32_t *)(base +
+		    (uintptr_t)row * (uintptr_t)row_bytes);
+
+		for (col = 0; col < 1440; col++) {
+			pixel[col] = 0xFF000000;
+		}
+	}
+	for (cursor = text; *cursor != '\0'; cursor++) {
+		if (y + 7 >= 900) {
+			break;
+		}
+		if (x > 1440 - 6) {
+			zorn_say_flush_span(base, row_bytes, y, scale, 1440);
+			y += 8;
+			x = 8;
+			if (y + 7 >= 900) {
+				break;
+			}
+		}
+		zorn_draw_char(base, row_bytes, x, y, scale, zorn_glyph_for(*cursor));
+		x += 6;
+	}
+	if (y + 7 < 900) {
+		zorn_say_flush_span(base, row_bytes, y, scale, 1440);
+	}
+}
+
+void
+zorn_say(const char *text)
+{
+	extern volatile int zorn_read_trace;
+	extern volatile int zorn_read_irqs_on;
+	uintptr_t base = 0xFC400000;
+	const int row_bytes = 5760;
+	int row;
+	int col;
+	int status_x;
+	int clear_cols;
+	uint64_t daif;
+
+	/* PAGE and INIT run on two threads. Mask IRQs so the cursor stays consistent. */
+	__asm__ volatile("mrs %0, daif" : "=r"(daif));
+	if (!zorn_daif_held) {
+		zorn_saved_daif = daif;
+	}
+	__asm__ volatile("msr daifset, #15" ::: "memory");
+	if (text == NULL || *text == '\0') {
+		zorn_daif_held = 0;
+		__asm__ volatile("msr daif, %0" :: "r"(zorn_saved_daif) : "memory");
+		return;
+	}
+	/* One line under the color bars. The lower panel is not in the early
+	 * page tables, so a scrolling log faults on the pixel store.
+	 * Cleaning the whole row does not return once an exclusive lock is held.
+	 * VLOK is printed in that state. Clean only the glyphs.
+	 */
+	clear_cols = 320;
+	for (row = 0; row < 7 * 5; row++) {
+		volatile uint32_t *pixel = (volatile uint32_t *)(base +
+		    (uintptr_t)(840 + row) * row_bytes);
+
+		for (col = 0; col < clear_cols; col++) {
+			pixel[col] = 0xFF000000;
+		}
+	}
+	status_x = 40;
+	zorn_draw_text(base, row_bytes, &status_x, 840, 5, text);
+	{
+		extern void zorn_ufs_log_word(const char *);
+		zorn_ufs_log_word(text);
+	}
+	zorn_say_flush_span(base, row_bytes, 840, 5, 320);
+	if (zorn_read_trace && !zorn_read_irqs_on) {
+		/* Restoring DAIF here stops the read. Leave it masked until the lock is held. */
+		zorn_daif_held = 1;
+	} else {
+		zorn_daif_held = 0;
+		__asm__ volatile("msr daif, %0" :: "r"(zorn_saved_daif) : "memory");
+	}
+}
