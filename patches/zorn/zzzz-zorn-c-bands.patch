 /*
+ * Repaint one 1/16 framebuffer band through the bootstrap V=P map.
+ * Band 1 turns green once arm_init runs. Band 3 is black while the
+ * timer event stream is armed, yellow while the CPU topology is parsed,
+ * white while the bootstrap thread is created, and cyan during
+ * cpu_bootstrap. Band 2 turns red when the platform expert returns.
+ * Band 0 then leaves blue: green is the early clock, yellow is startup
+ * hooks, orange is cpu_init, white is arm_vm_init, cyan means that
+ * returned.
+ */
+static void
+zorn_fb_band(boot_args *args, unsigned int band, uint32_t color)
+{
+	uintptr_t base;
+	uint64_t row;
+	uint64_t bytes;
+	uint64_t off;
+
+	if (args->Video.v_baseAddr == 0 || args->Video.v_rowBytes < 8 || args->Video.v_height < 16) {
+		return;
+	}
+	row = args->Video.v_rowBytes;
+	bytes = (args->Video.v_height >> 4) * row;
+	base = (uintptr_t)args->Video.v_baseAddr + band * bytes;
+	for (off = 0; off + 8 <= bytes; off += 8) {
+		*(volatile uint64_t *)(base + off) = ((uint64_t)color << 32) | color;
+	}
+	for (off = 0; off + 64 <= bytes; off += 64) {
+		__asm__ volatile("dc civac, %0" :: "r"(base + off) : "memory");
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+void
+zorn_fb_top(boot_args *args, uint32_t color)
+{
+	zorn_fb_band(args, 0, color);
+}
