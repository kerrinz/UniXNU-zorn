+#if defined(XNU_NATIVE_LEGACY_DISPLAY) && XNU_NATIVE_LEGACY_DISPLAY
+/* zorn: passive, bounded GUI task observations, following houji's sampler.
+ * No observer tick pets the watchdog or changes a process's execution. */
+extern void zorn_gui_sample_task(const char *, int, task_t);
+extern void zorn_ufs_runtime_snapshot(void);
+extern void zorn_ufs_user_output(unsigned, const char *, size_t);
+
+static int
+zorn_gui_sample_wanted(proc_t p, __unused void *arg)
+{
+	return proc_getpid(p) == 1 || !strcmp(p->p_comm, "SpringBoard") ||
+	       !strcmp(p->p_comm, "backboardd");
+}
+
+static int
+zorn_gui_sample_proc(proc_t p, __unused void *arg)
+{
+	char name[MAXCOMLEN + 1] = {0};
+	proc_name(proc_getpid(p), name, sizeof(name));
+	task_t task = proc_task(p);
+	if (task != TASK_NULL) {
+		task_reference(task);
+		zorn_gui_sample_task(name, proc_getpid(p), task);
+		task_deallocate(task);
+	}
+	return PROC_RETURNED;
+}
+
+static void
+zorn_gui_sample_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	static int channel;
+	for (unsigned sample = 1; sample <= 12; ++sample) {
+		(void)tsleep(&channel, PZERO, "zorngui", 15 * hz);
+		char text[64];
+		int n = snprintf(text, sizeof(text), "GUI SAMPLE %u/12 ", sample);
+		if (n > 0) zorn_ufs_user_output(0, text, (size_t)n);
+		proc_iterate(PROC_ALLPROCLIST, zorn_gui_sample_proc, NULL,
+		    zorn_gui_sample_wanted, NULL);
+		zorn_ufs_runtime_snapshot();
+	}
+	thread_terminate(current_thread());
+}
+
+static void
+zorn_gui_watch_start(void)
+{
+	int enabled = 0;
+	if (!PE_parse_boot_argn("zorn_gui_watch", &enabled, sizeof(enabled)) || enabled != 1) return;
+	thread_t thread = THREAD_NULL;
+	if (kernel_thread_start(zorn_gui_sample_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#endif
