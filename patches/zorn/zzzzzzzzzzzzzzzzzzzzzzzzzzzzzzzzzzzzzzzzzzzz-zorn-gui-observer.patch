+#if defined(__arm64__) && !defined(APPLE_ARM64_ARCH_FAMILY)
+#include <arm/thread.h>
+#include <vm/vm_shared_region.h>
+
+extern void zorn_ufs_user_output(unsigned, const char *, size_t);
+
+/* zorn GUI observer. Snapshot at most four threads under task_lock; read
+ * user frames only after unlocking, using an independently referenced map.
+ * Register/stack values are observational and may race a running process. */
+void
+zorn_gui_sample_task(const char *name, int pid, task_t task)
+{
+	struct zorn_gui_regs {
+		uint64_t pc, lr, sp, fp, wait, continuation;
+		uint32_t state;
+	} regs[4] = {0};
+	unsigned count = 0;
+	bool truncated = false;
+	vm_map_t map = get_task_map_reference(task);
+	if (map == VM_MAP_NULL) return;
+	uint64_t slide = 0, header = 0;
+	vm_shared_region_t sr = vm_shared_region_get(task);
+	if (sr != NULL) {
+		slide = sr->sr_slide;
+		vm_shared_region_deallocate(sr);
+	}
+	task_lock(task);
+	header = task->mach_header_vm_address;
+	thread_t thread;
+	queue_iterate(&task->threads, thread, thread_t, task_threads) {
+		arm_saved_state_t *ss = find_user_regs(thread);
+		if (ss == NULL || !is_saved_state64(ss)) continue;
+		if (count == 4) { truncated = true; break; }
+		regs[count++] = (struct zorn_gui_regs){
+			.pc = get_saved_state_pc(ss), .lr = get_saved_state_lr(ss),
+			.sp = get_saved_state_sp(ss), .fp = get_saved_state_fp(ss),
+			.wait = thread->wait_event, .continuation = (uintptr_t)thread->continuation,
+			.state = thread->state,
+		};
+	}
+	task_unlock(task);
+	char text[256];
+	int n = snprintf(text, sizeof(text), "GUI %s[%d] slide=%llx mh=%llx threads=%u truncated=%u ",
+	    name, pid, slide, header, count, truncated);
+	if (n > 0) zorn_ufs_user_output(0, text, (size_t)n < sizeof(text) ? (size_t)n : sizeof(text) - 1);
+	for (unsigned i = 0; i < count; ++i) {
+		uint64_t fp = regs[i].fp, backtrace[2] = {0};
+		for (unsigned depth = 0; depth < 2 && fp && !(fp & 15); ++depth) {
+			uint64_t frame[2];
+			if (fp >= vm_map_max(map) || vm_map_max(map) - fp < sizeof(frame) ||
+			    vm_map_read_user(map, fp, frame, sizeof(frame)) != KERN_SUCCESS) break;
+			backtrace[depth] = frame[1];
+			if (frame[0] <= fp) break;
+			fp = frame[0];
+		}
+		n = snprintf(text, sizeof(text), "GUI %s t%u pc=%llx lr=%llx sp=%llx state=%x wait=%llx cont=%llx bt=%llx,%llx ",
+		    name, i, regs[i].pc, regs[i].lr, regs[i].sp, regs[i].state,
+		    regs[i].wait, regs[i].continuation, backtrace[0], backtrace[1]);
+		if (n > 0) zorn_ufs_user_output(0, text, (size_t)n < sizeof(text) ? (size_t)n : sizeof(text) - 1);
+	}
+	vm_map_deallocate(map);
+}
+#endif
 
