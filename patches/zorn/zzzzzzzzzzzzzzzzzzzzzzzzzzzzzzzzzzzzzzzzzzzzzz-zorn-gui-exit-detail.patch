 #include <sys/zorn_gui_log.h>
+void
+zorn_gui_exit_regs(task_t task, struct ZornGuiExitDetail *detail)
+{
+    if (current_task() == task) {
+        arm_saved_state_t *ss = find_user_regs(current_thread());
+        if (ss != NULL && is_saved_state64(ss)) {
+            detail->pc = get_saved_state_pc(ss); detail->lr = get_saved_state_lr(ss);
+            detail->far = get_saved_state_far(ss); detail->esr = get_saved_state_esr(ss);
+            detail->cpsr = get_saved_state_cpsr(ss);
+        }
+    }
+    vm_shared_region_t sr = vm_shared_region_get(task);
+    if (sr != NULL) { detail->slide = sr->sr_slide; vm_shared_region_deallocate(sr); }
+    task_lock(task); detail->header = task->mach_header_vm_address; task_unlock(task);
+}
