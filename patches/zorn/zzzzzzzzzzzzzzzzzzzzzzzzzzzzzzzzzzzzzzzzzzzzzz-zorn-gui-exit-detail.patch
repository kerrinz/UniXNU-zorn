+    if (zorn_ufs_gui_enabled() && (proc_getpid(p) == 1 ||
+        !strcmp(p->p_comm, "SpringBoard") || !strcmp(p->p_comm, "backboardd") ||
+        !strcmp(p->p_comm, "launchd"))) {
+        struct ZornGuiExitDetail detail = {0};
+#if defined(__arm64__) && !defined(APPLE_ARM64_ARCH_FAMILY)
+        zorn_gui_exit_regs(task, &detail);
+#endif
+        const char *description = exit_reason_get_string_desc(exit_reason);
+        if (description && exit_reason && exit_reason->osr_kcd_buf) {
+            uintptr_t base = (uintptr_t)exit_reason->osr_kcd_buf;
+            uintptr_t pos = (uintptr_t)description;
+            if (pos >= base && pos - base < exit_reason->osr_bufsize) {
+                size_t bound = exit_reason->osr_bufsize - (pos - base);
+                if (bound > sizeof(detail.reason) - 1) bound = sizeof(detail.reason) - 1;
+                memcpy(detail.reason, description, strnlen(description, bound));
+            }
+        }
+        zorn_ufs_exit_report(proc_getpid(p), p->p_comm, rv,
+            exit_reason ? exit_reason->osr_namespace : 0,
+            exit_reason ? exit_reason->osr_code : 0, &detail);
+    }
 
