 	cred = vfs_context_ucred(ctx);
-	if (!mac_cred_check_enforce(cred)) {
-		return 0;
+	zorn_say("MACP");
+	{
+		proc_ro_t ro = kernproc->p_proc_ro;
+		kauth_cred_t kcred = NULL;
+
+		if (ro != NULL) {
+			kcred = smr_serialized_load(&ro->p_ucred);
+		}
