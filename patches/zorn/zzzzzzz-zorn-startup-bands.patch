-void
-machine_startup(__unused boot_args * args)
+static boot_args *zorn_paint_args = (boot_args *)1;
+
+static void
+zorn_paint(boot_args *args, uint32_t color)
+{
+	uintptr_t base;
+	uint64_t row;
+	uint64_t bytes;
+	uint64_t off;
+
+	if (args == NULL || args->Video.v_baseAddr == 0 || args->Video.v_rowBytes < 8 ||
+	    args->Video.v_height < 16) {
+		return;
+	}
+	row = args->Video.v_rowBytes;
+	bytes = (args->Video.v_height >> 4) * row;
+	base = (uintptr_t)args->Video.v_baseAddr;
+	for (off = 0; off + 8 <= bytes; off += 8) {
+		*(volatile uint64_t *)(base + off) = ((uint64_t)color << 32) | color;
+	}
+	for (off = 0; off + 64 <= bytes; off += 64) {
+		__asm__ volatile("dc civac, %0" :: "r"(base + off) : "memory");
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+void
+zorn_top_band(uint32_t color)
+{
+	zorn_paint(zorn_paint_args, color);
+}
+
+void
+machine_startup(boot_args * args)
 {
+	extern void zorn_fb_top(boot_args *args, uint32_t color);
+	extern void zorn_say(const char *text);
