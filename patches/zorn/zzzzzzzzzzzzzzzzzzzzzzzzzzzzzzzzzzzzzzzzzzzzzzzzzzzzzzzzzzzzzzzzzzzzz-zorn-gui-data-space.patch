+
+static __attribute__((noinline)) void
+zorn_gui_data_space(void)
+{
+	uint64_t values[6] = { ENXIO, 0, 0, 0, 0, 0 };
+	if (!zorn_ufs_boot_policy_allowed()) {
+		zorn_ufs_gui_data_space(values);
+		return;
+	}
+	values[0] = 0;
+	vnode_t vp = NULLVP;
+	vfs_context_t ctx = vfs_context_kernel();
+	int error = vnode_lookup("/private/var", 0, &vp, ctx);
+	if (!error) {
+		mount_t mp = vnode_mount(vp);
+		if (!mp || !rootvnode || mp == vnode_mount(rootvnode)) {
+			error = EXDEV;
+		} else {
+			struct vfs_attr attr;
+			bzero(&attr, sizeof(attr));
+			VFSATTR_INIT(&attr);
+			VFSATTR_WANTED(&attr, f_bsize);
+			VFSATTR_WANTED(&attr, f_blocks);
+			VFSATTR_WANTED(&attr, f_bavail);
+			VFSATTR_WANTED(&attr, f_uuid);
+			error = vfs_getattr(mp, &attr, ctx);
+			if (!error) {
+				unsigned supported = 0;
+				if (VFSATTR_IS_SUPPORTED(&attr, f_bsize)) { supported |= 1; values[1] = attr.f_bsize; }
+				if (VFSATTR_IS_SUPPORTED(&attr, f_blocks)) { supported |= 2; values[2] = attr.f_blocks; }
+				if (VFSATTR_IS_SUPPORTED(&attr, f_bavail)) { supported |= 4; values[3] = attr.f_bavail; }
+				if (VFSATTR_IS_SUPPORTED(&attr, f_uuid)) { supported |= 8; memcpy(&values[4], attr.f_uuid, 16); }
+				values[0] = (uint64_t)supported << 32;
+			}
+		}
+		vnode_put(vp);
+	}
+	values[0] |= (uint32_t)error;
+	zorn_ufs_gui_data_space(values);
 }
 
