-                        "mov	x4, #0"                 "\n"
-                        "mov	x5, #0"                 "\n"
-                        "msr	SPSel, #1"              "\n"
-                        VERIFY_USER_THREAD_STATE_INSTR  "\n"
-                        "mov	x6, lr"                 "\n"
-                        "bl     _ml_sign_thread_state"  "\n"
-                        "msr	SPSel, #0"              "\n"
-                        "mov	lr, x6"                 "\n"
-                        :
-                        : [iss] "r"(thread->machine.upcb), [usr] "r"(thread->machine.upcb->ss_64.cpsr),
