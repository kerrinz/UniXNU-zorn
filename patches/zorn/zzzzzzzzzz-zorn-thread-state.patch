-                        : "x0", "x1", "x2", "x3", "x4", "x5", "x6"
-                );
-		ml_pac_safe_interrupts_restore(intr);
+		zorn_say("MSKP");
 	}
 #endif /* defined(HAS_APPLE_PAC) */
+	zorn_say("MPAD");
 }
 
