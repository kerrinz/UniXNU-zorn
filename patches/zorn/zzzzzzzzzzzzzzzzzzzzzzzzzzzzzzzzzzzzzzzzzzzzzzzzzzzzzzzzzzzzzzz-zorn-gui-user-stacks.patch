 #include <sys/zorn_gui_log.h>
+static void
+zorn_gui_sample_stack(const char *name, int pid, task_t task,
+    const struct ZornGuiProcess *process)
+{
+    unsigned enabled = 0;
+    if (!process->count || !PE_parse_boot_argn("zorn_gui_stack", &enabled, sizeof(enabled)) || enabled != 1)
+        return;
+    struct ZornGuiUserStack stack = {.pid = (uint32_t)pid};
+    zorn_ufs_gui_stage(0, 13, pid);
+    vm_map_t map = get_task_map_reference(task);
+    if (map == VM_MAP_NULL) {
+        stack.error = KERN_FAILURE;
+        zorn_ufs_gui_stack(name, &stack);
+        return;
+    }
+    uint64_t sp = process->threads[0].sp, fp = process->threads[0].fp;
+    for (unsigned i = 0; i < ZORN_GUI_STACK_FRAMES; ++i) {
+        if (!zorn_gui_stack_frame_valid(sp, fp, vm_map_min(map), vm_map_max(map))) {
+            stack.error = KERN_INVALID_ADDRESS;
+            break;
+        }
+        uint64_t pair[2] = {0};
+        zorn_ufs_gui_stage(0, 14, pid);
+        stack.error = vm_map_read_user(map, fp, pair, sizeof(pair));
+        if (stack.error) break;
+        if (pair[1] < vm_map_min(map) || pair[1] >= vm_map_max(map)) {
+            stack.error = KERN_INVALID_ADDRESS;
+            break;
+        }
+        stack.frames[stack.count++] = pair[1];
+        zorn_ufs_gui_stack(name, &stack);
+        if (!pair[0]) break;
+        if (pair[0] <= fp) { stack.error = KERN_INVALID_ADDRESS; break; }
+        fp = pair[0];
+    }
+    vm_map_deallocate(map);
+    zorn_ufs_gui_stack(name, &stack);
+    zorn_ufs_gui_stage(0, 7, pid);
+}
